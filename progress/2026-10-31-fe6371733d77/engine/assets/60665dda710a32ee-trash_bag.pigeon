# Чёрный мешок с мусором у будки (уровень 1): клевать (или пинать) — шуршит, на третий раз рвётся, и из него
# вываливается еда. Порванный оседает.

import props

character trash_bag:
    title "Мешок с мусором"
    preview "l1_home.bag_big"
    preview "props.prop_trash_bags"
    show("l1_home", "bag_big", "props", "prop_trash_bags")
    hitbox -75 75 0 130

# Сколько ударов держит мешок (пинок — за два)
const TEARS = 3

var hits = 0
var torn = false

func poke(n):
    hits += n
    wobble()
    sfx "rip"
    dust 0.5 x (ground - 40)
    if hits >= TEARS: tear()
    else: popup x (ground - 170) pick("Шурх!", "Хрусть!", "Ещё чуть-чуть…") "#e8dcc4"

func tear():
    torn = true
    if has_frame("l1_home.bag_big_torn"): pose "l1_home.bag_big_torn"
    else: scale_y = 0.82
    sfx "rip"
    var side = -away()
    toss_food "pizza" (x + side * 130) x (ground - 90)
    toss_food "sandwich" (x + side * 220) x (ground - 90)
    toss_food "crumbs_pile" (x - side * 110) x (ground - 90)
    big_dust x ground
    award 50 "Мешок вскрыт!" x (ground - 220)
    objective "home_bag"

state lie:
    pass

every frame:
    reveal_near("home_bag", 450)

on peck:
    if torn: return false
    poke(1)
    return true

on kick:
    if torn:
        wobble()
        return true
    poke(2)
    return true
