# Открываем именно дверь постройки: щиток справа к этому переходу не относится.
cutscene hut_enter

actor hut_door

at 0:
    var walk_time = pigeon.walk_to(hut_door.x - 100)
    wait walk_time + 0.15
    pigeon.face 1
    if not hut_door.is_open():
        pigeon.kick()
        wait 0.12
        var opening_time = hut_door.play("opening")
        sfx "clink"
        wait opening_time
        hut_door.finish_open()
    end_cutscene
