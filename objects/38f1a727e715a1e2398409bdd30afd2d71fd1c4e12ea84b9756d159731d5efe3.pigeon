# Дети на тротуаре (старый уровень 1 на лентах фона), компания по level.gang. Девочка-наводчица крутит
# головой и, заметив голубя, поднимает тревогу; шапка кидает камни; кепка сыплет крошки. Облитый ребёнок
# пугается и убегает; разбежались все — бонус.

import common

character kid:
    title "Ребёнок"
    preview "kids.kid_girl_idle"
    preview "kids.kid_beanie_idle" if level.role == "beanie"
    preview "kids.kid_cap_idle" if level.role == "cap"
    param role "Кто" choice girl "Девочка", beanie "В шапке", cap "В кепке"
    param gang "Банда" text = "default" "Дети с одним именем банды — одна компания: разбегаются вместе"
    atlas = "kids"
    shadow = 190
    role = level.role
    if level.facing == 0: facing = -1
    hitbox -80 80 0 300
    gang = group("kids:" + level.gang)
    if gang.kids == nil:
        gang.kids = []
        gang.alarm_until = 0
        gang.announced = false
    append gang.kids self

# На какой высоте над землёй девочка ещё замечает голубя и как далеко
const SIGHT_HEIGHT = 430
const SIGHT_RANGE = 820
const STONE_COOLDOWN = 1.4
const MAX_POURS = 4

var role = ""
var gang = nil
var look_timer = random(2, 3.5)
var cooldown = 0
var pours = 0
var bob = random(10)

func scared():
    return state == cower or state == flee

func sees_pigeon():
    var d = dx
    var in_front = sign(d) == facing or abs(d) < 220
    return in_front and abs(d) < SIGHT_RANGE and pigeon.feet_y > y - SIGHT_HEIGHT

# Общая тревога компании: девочка замечает голубя — остальные действуют
func alarmed():
    return clock < gang.alarm_until

func raise_alarm():
    gang.alarm_until = max(gang.alarm_until, clock + 5)

state idle:
    if role == "girl": play "girl_idle"
    else: pose "kid_" + role + "_idle"
    every frame:
        if role == "girl":
            look_timer -= dt
            if look_timer <= 0:
                facing = -facing
                look_timer = random(2.2, 3.8)
            if sees_pigeon(): go alarm
        if role == "beanie" and alarmed(): go alarm
        if role == "cap":
            if alarmed(): go alarm
            cooldown -= dt
            if cooldown <= 0 and pours < MAX_POURS and abs(dx) < 1400: go pour

state alarm:
    face pigeon
    pose "kid_" + role + "_point"
    if role == "girl":
        raise_alarm()
        say "Голубь!!! Вон он!" 1.4 330
        if in_view(): sfx "alarm"
    if role == "cap":
        play "cap_laugh"
        if in_view(): sfx "laugh"
    cooldown = 0.5
    every frame:
        face pigeon
        if role == "girl":
            alert true 340
            if sees_pigeon(): raise_alarm()
        if role == "beanie":
            cooldown -= dt
            if cooldown <= 0 and abs(dx) < 1300: go throw
        if not alarmed(): go idle

on leave "alarm":
    alert false

# Целимся с упреждением
state throw:
    face pigeon
    play "beanie_throw"
    wait 0.48
    face pigeon
    throw_stone (x + facing * 70) (y - 230) (pigeon.x + pigeon.walk_vx * 0.35) (pigeon.feet_y - 40)
    cooldown = STONE_COOLDOWN
    go alarm

state pour:
    play "cap_pour"
    wait 0.6
    pours += 1
    spawn_food "crumbs" (x + facing * random_int(120, 190)) y
    cooldown = random(3.5, 5)
    go idle

state cower:
    play role + "_cower"
    say pick("Фууу!", "Мамааа!", "Он насрал на меня!") 1.4 300
    if in_view(): sfx "eww"
    wait 1.2
    go flee

state flee:
    play role + "_walk"
    run_away(0, 420, 1.2)

on hit:
    if scared(): return
    score_hit 50
    hit_stop 0.04
    go cower

every frame:
    # Лёгкое покачивание, чтобы статичные кадры не выглядели картонками
    if state == flee:
        bob += dt * 14
        draw_dy = -abs(sin(bob)) * 8
    else:
        bob += dt * 2.2
        draw_dy = sin(bob) * 1.5
    # Разбежались все — бонус, один раз на компанию
    if not gang.announced:
        var all = true
        for k in gang.kids:
            if not k.scared(): all = false
        if all:
            gang.announced = true
            toast "Дети разбежались! +100"
            sfx "pickup"
            add_score 100
