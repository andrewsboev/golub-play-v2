# Наставник в обучении (уровень tutorial): старый городской голубь в кепке и шарфе. Прилетает к голубю и учит по шагам:
# ходить, взлетать, планировать, клевать, курлыкать, гадить и прятаться в бак. Шаг засчитан — дело в «Голубиных
# делах», похвала, наставник летит к следующему месту. Подсказка с клавишами — строкой урока внизу экрана.

character mentor:
    title "Наставник (обучение)"
    preview "mentor.mentor_idle"
    atlas = "mentor"
    depth = DEPTH_NPC
    say_height = 165
    shadow = 0
    hitbox -45 45 0 120
    x = -150
    y = ground - 420
    # Головой следит за голубем (оживший кадр — риги mentor_idle, mentor_talk в assets\meshanim)
    look_at pigeon

# Где что стоит на уровне (tutorial_blocks.json): спинка второй скамейки, бак
const BENCH_X = 1560
const BENCH_TOP = 212
const BIN_X = 3300
const PECK_HINT = "{peck} — клевать. Склюй все крошки"
const DROP_HINT = "Спрыгнуть вниз — {down} и {flap} вместе"

# Подсказка текущего шага (строка урока внизу экрана)
var hint = ""
var cooed = false
var pooped = false
var lost = false
var clerk = nil

# Перелёт: машет крыльями по дуге (плавный разгон и посадка), садится
func fly_to(tx, ty, secs):
    face_to tx
    play "mentor_fly"
    var x0 = x
    var y0 = y
    var t = 0
    while t < secs:
        wait 0
        t += dt
        var k = min(1, t / secs)
        var e = k * k * (3 - 2 * k)
        x = lerp(x0, tx, e)
        y = lerp(y0, ty, e) - sin(pi * k) * 110
    pose "mentor_land"
    wait 0.15
    pose "mentor_idle"

# Новый шаг: строка урока внизу экрана — держится, пока шаг не сделан
func teach(text):
    hint = text
    lesson text

func done(id, line):
    objective id
    teach("")
    face pigeon
    play "mentor_laugh"
    say line 1.4
    wait 1.5
    pose "mentor_idle"

state intro:
    wait 0.6
    fly_to(pigeon.x + 260, ground, 1.4)
    face pigeon
    pose "mentor_talk"
    say "Эй, птенец! Город — не гнездо." 2
    wait 2.1
    say "Учись, пока я жив." 1.4
    wait 1.5
    go walk

state walk:
    fly_to(1000, ground, 1.1)
    face pigeon
    pose "mentor_talk"
    say "Топай ко мне!" 1.4
    teach("{move} — идти")
    wait 0.6
    pose "mentor_idle"
    wait until abs(dx) < 150
    done("tut_walk", "Ходить умеешь. Уже неплохо.")
    go flap

state flap:
    fly_to(BENCH_X + 60, ground - BENCH_TOP, 1.0)
    face pigeon
    play "mentor_point"
    say "Теперь крылья. Залезай ко мне!" 1.8
    teach("{flap} — взмах. Жми несколько раз — поднимешься выше")
    wait until pigeon.on_ground and pigeon.feet_y < ground - 150 and abs(dx) < 320
    done("tut_flap", "Вот это я понимаю — полёт!")
    go glide

state glide:
    fly_to(2280, ground, 1.0)
    face pigeon
    pose "mentor_talk"
    say "А теперь вниз — красиво!" 1.6
    teach("Держи {flap} в падении — будешь планировать")
    wait 0.8
    pose "mentor_idle"
    # Сел рядом — на землю или на ограду (она тянется вдоль всего парка)
    wait until pigeon.on_ground and pigeon.feet_y > ground - 260 and abs(dx) < 260
    done("tut_glide", "Мягко сел. Талант!")
    go peck

state peck:
    face pigeon
    pose "mentor_talk"
    say "Жрать — это святое." 1.4
    spawn_food "crumbs" (x + 120) ground
    spawn_food "crumbs" (x + 200) ground
    spawn_food "crumbs" (x + 280) ground
    teach(PECK_HINT)
    wait 0.6
    pose "mentor_idle"
    # Стоит на ограде или скамейке — сперва подсказать, как спрыгнуть
    every frame:
        if food_near(x + 200, 220) == 0: break
        var high = pigeon.on_ground and pigeon.feet_y < ground - 60
        if high and hint == PECK_HINT: teach(DROP_HINT)
        elif pigeon.on_ground and not high and hint == DROP_HINT: teach(PECK_HINT)
    done("tut_peck", "Ам! Вот и позавтракали.")
    go coo

state coo:
    clerk = actor("tut_clerk")
    fly_to(2380, ground, 0.6)
    face 1
    play "mentor_point"
    say "Видишь клерка с кофе?" 1.6
    wait 1.7
    pose "mentor_talk"
    say "Курлыкни у него за спиной!" 1.6
    teach("Подойди к нему сзади и курлыкни ({coo}) — с перепугу уронит кофе")
    wait 0.8
    pose "mentor_idle"
    wait until cooed
    done("tut_coo", "Ха! Уронил!")
    go drink

state drink:
    pose "mentor_talk"
    say "Кофе — тоже еда. Пей!" 1.4
    teach("Клюй кофе ({peck}) — выпьешь")
    wait 0.6
    pose "mentor_idle"
    wait until food_near(clerk.x, 320) == 0
    done("tut_drink", "Бодрит, а?")
    go poop

state poop:
    pose "mentor_talk"
    say "А теперь — главное." 1.4
    wait 1.5
    say "Взлети над ним — и огонь!" 1.6
    teach("Взлети над клерком и насри ({poop}). Помёт копится в зобе, когда ешь")
    wait 0.8
    pose "mentor_idle"
    wait until pooped
    done("tut_poop", "Прямо на пиджак! Горжусь!")
    go hide

state hide:
    # Рядом с баком, не на крышке — крышку займёт голова голубя
    fly_to(BIN_X + 170, ground, 0.8)
    face pigeon
    play "mentor_point"
    say "Он злой! Прячься в бак!" 1.6
    teach("Злодей идёт? Встань у бака и нажми {down} — спрячешься. Вылезти — любое движение")
    wait 0.8
    pose "mentor_idle"
    wait until pigeon.hidden
    objective "tut_hide"
    teach("")
    wait until lost
    wait 0.6
    play "mentor_laugh"
    say "Видал? Бак — лучший друг голубя." 2
    wait 2.1
    pose "mentor_talk"
    say "Вылезай, он ушёл." 1.4
    teach("Вылезти из бака — любое движение")
    wait 0.6
    pose "mentor_idle"
    wait until not pigeon.hidden
    teach("")
    go outro

state outro:
    wait 0.8
    face pigeon
    pose "mentor_talk"
    say "Ну всё, птенец. Дальше сам." 1.8
    wait 1.9
    say "И держись подальше от бабки с тазиком!" 2
    wait 2.1
    play "mentor_laugh"
    wait 0.5
    # Улетает вверх и прочь
    fly_to(x + 900, y - 700, 1.4)
    finish_tutorial

on tut_coo:
    cooed = true

on tut_hit:
    pooped = true

on tut_lost:
    lost = true

# Попал в наставника — не в того
on hit:
    say pick("Эй! Не в меня!", "Целься в людей, балбес!") 1.2

