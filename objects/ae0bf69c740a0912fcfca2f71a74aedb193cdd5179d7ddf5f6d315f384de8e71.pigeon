# Электрощиток у будки (уровень 1): насрать на него — коротит: искры, треск 2–3 с, лампа над дверью (level.x2)
# мигает, из-под крышки тянет дымок. После третьего раза щиток выгорает: дверца нараспашку, из щели всё время
# дымит, изредка беззвучно искрит, лампа гаснет и только иногда вспыхивает. Клюнуть или пнуть щиток — бьёт током:
# минус сердце, голубя отбрасывает. Сверху на щитке можно сидеть.

import props

character power_box:
    title "Электрощиток"
    preview "l1_home.cabinet"
    param x2 "Лампа" number step 10 "x лампы над дверью; 0 — на 300 левее щитка"
    atlas = "l1_home"
    pose "cabinet"
    hitbox -135 135 0 top
    add_perch (x - 130) (ground - top) 260
    lamp_x = level.x2
    if lamp_x == 0: lamp_x = x - 300
    lamp = sprite("l1_home", "lamp_on", lamp_x, ground - lamp_h, depth=DEPTH_BACK, origin_x=0.5, origin_y=0)
    light = glow(lamp_x, ground - lamp_h + 60, 170, "#ffd98a", 0.55, depth=DEPTH_BACK)
    light.flicker = 0.05
    death_line = "Голубя ударило током у трансформаторной будки"

# Сколько коротких замыканий щиток выдерживает
const SHORTS = 3
# Сколько длится замыкание (треск, мигание), с
const SHORT_TIME = 2.4
# Щель приоткрытой дверцы выгоревшего щитка — откуда дым (от точки щитка по x)
const GAP_DX = 38

# Высота щитка и где висит лампа (верх плафона над землёй)
var top = 365
var lamp_h = 568
var lamp = nil
var light = nil
var lamp_x = 0
var shorts = 0
var lamp_on = true
var spark_in = 0
var smoke_in = 0
var flash_in = 0

func set_lamp(lit):
    lamp_on = lit
    light.visible = lit
    if lamp != nil:
        if lit: lamp.frame = "l1_home.lamp_on"
        else: lamp.frame = "l1_home.lamp_off"

# Искры без звука (звук — один на всё замыкание)
func spark(n):
    sparks (x + random(-60, 60)) (ground - top + random(20, 90)) n

# Голубь сунулся к щитку — его бьёт током
func zap_pigeon():
    sparks pigeon.x (pigeon.feet_y - 50) 14
    sfx "zap"
    feather pigeon.x (pigeon.feet_y - 50) 3
    # Минус сердце и отброс; только что ударило (неуязвим) — просто отбрасывает
    if not hurt_pigeon(x): shove_pigeon x
    popup pigeon.x (pigeon.feet_y - 170) "Бз-з-з!" "#ffe066"
    hint_once "zap" "Щиток бьёт током. Может, с безопасного расстояния — {poop}?"

state ok:
    pass

# Коротнуло: треск, лампа мигает, щиток искрит, из-под крышки дымок
state shorting:
    spark(26)
    sfx "short_circuit"
    shake 0.15 0.004
    every frame:
        if time > SHORT_TIME:
            if shorts >= SHORTS: go burnt
            set_lamp(true)
            go ok
        spark_in -= dt
        if spark_in <= 0:
            spark_in = random(0.05, 0.16)
            set_lamp(not lamp_on)
            if chance(0.3): spark(6)
        smoke_in -= dt
        if smoke_in <= 0:
            smoke_in = random(0.25, 0.4)
            smoke (x + random(-40, 40)) (ground - top + 10) 0.8

# Выгорел: дверца нараспашку, из щели всё время дымит, иногда искрит, лампа чаще не горит
state burnt:
    if has_frame("l1_home.cabinet_burnt"): pose "l1_home.cabinet_burnt"
    set_lamp(false)
    spark_in = random(1.5, 3.5)
    every frame:
        smoke_in -= dt
        if smoke_in <= 0:
            smoke_in = random(0.18, 0.3)
            smoke (x + GAP_DX + random(-8, 8)) (ground - top + 8)
        spark_in -= dt
        if spark_in <= 0:
            spark_in = random(2.5, 5)
            if in_view(): spark(6)
            set_lamp(true)
            flash_in = random(0.05, 0.12)
        if flash_in > 0:
            flash_in -= dt
            if flash_in <= 0: set_lamp(false)

every frame:
    reveal_near("home_zap", 550)

on hit:
    if state == burnt:
        spark(10)
        sfx "zap"
        return
    shorts += 1
    if shorts == 1:
        award 150 "Короткое замыкание!" x (ground - top - 60)
        objective "home_zap"
    else: score_hit 60 hx hy
    go shorting

on peck:
    zap_pigeon()
    return true

on kick:
    zap_pigeon()
    return true
