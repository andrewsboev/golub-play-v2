# Уровень 1 (docs/LEVEL1_HOME.md): экран 1 — «домашняя территория голубя» (служебная будка у парка, весь словарь
# голубя без врагов), экран 2 — парковая дорожка с доской объявлений мэрии и первым мини-боссом, парковым
# жирдяем (park_jerk.pigeon). Предметы и персонажи — свои сценарии; здесь — дела «сесть повыше» (зоны goal:
# name — дело), бой с жирдяем при смерти голубя и край собранного куска уровня.

level level1:
    goals = zones("goal")
    edges = zones("edge")

var goals = []
var edges = []
var all_said = false
var edge_said = false

every frame:
    # Сел на верхнюю точку (фонарь, крыша будки) — дело; подлетел ближе — дело видно
    for g in goals:
        if abs(pigeon.x - (g.x + g.w / 2)) < 500: reveal_objective g.name
        if pigeon.on_ground and pigeon_in(g.x, g.y, g.w, g.h):
            if objective(g.name): sparkle pigeon.x (pigeon.feet_y - 60)
    if not all_said and objective_done("home_bin") and objective_done("home_bag") and \
            objective_done("home_perch") and objective_done("home_roof") and objective_done("home_zap") and \
            objective_done("home_kick"):
        all_said = true
        banner "Свой двор изучен!"
    # Край собранного куска уровня
    for e in edges:
        if not edge_said and pigeon_in(e.x, e.y, e.w, e.h):
            edge_said = true
            toast e.text

# Голубь погиб в бою с жирдяем — тот доволен; появился снова у входа на арену — бой сначала
on death:
    var jerk = actor("park_jerk")
    if jerk != nil and jerk.engaged(): jerk.go("victory")

on respawn:
    var jerk = actor("park_jerk")
    if jerk != nil and in_arena("park") and not jerk.is_defeated():
        pigeon.hearts = max(pigeon.hearts, 3)
        pigeon.ammo = max(pigeon.ammo, 3)
        wait 1.2
        jerk.reset()

on park_jerk_defeated(jx):
    toast "Жирдяй повержен! Его булка — твоя ({peck})"
