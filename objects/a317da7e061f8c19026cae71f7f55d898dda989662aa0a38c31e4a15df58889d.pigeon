# Урна у фонаря (уровень 1, «домашняя территория»): клюнуть — порыться, к голубю вылетает еда; пнуть — урна
# гремит и тоже что-нибудь роняет. Опустела — только гремит. На крышку можно сесть, внутрь — спрятаться (↓).

import props

character trash_can:
    title "Урна"
    preview "bin.trash_can"
    atlas = "bin"
    pose "trash_can"
    hitbox -82 82 0 245
    add_perch (x - 80) (ground - 245) 160
    # В урну можно спрятаться (↓ рядом или на крышке), как в бак-блок
    hide_spot

var loot = ["fries", "bun", "crumbs_pile", "pretzel"]

# Вылетает первое из урны — в сторону голубя
func drop_one():
    if len(loot) == 0:
        popup x (ground - 290) "Пусто…" "#e8dcc4"
        return
    var f = loot[0]
    remove loot f
    var side = -away()
    toss_food f (x + side * random(90, 160)) x (ground - 230)
    sparkle x (ground - 250)

state stand:
    pass

every frame:
    reveal_near("home_bin", 500)
    # Во время боя с жирдяем — не мишень для помёта (помёт летит к нему)
    immune = in_arena("park")

on peck:
    wobble()
    sfx "bin"
    drop_one()
    objective "home_bin"
    return true

on kick:
    wobble()
    sfx "smash"
    dust 0.6 x (ground - 20)
    drop_one()
    return true
