# Свадьба у City Bread (level1_old) — событие мира без стен. Из пекарни выходит процессия:
# официант катит трёхъярусный торт к свадебной машине (x2), вокруг гости. По тротуару не пройти (толпа
# отталкивает), над ней не пролететь — тётушки сыплют рис на всё, что летит сверху, и в рисе кончаются силы.
# Жених гоняет голубя понизу и машет пиджаком, невеста бросает букет по дуге (замах — телеграф).
# - Обычная победа: три попадания по торту — он оседает, свадьба в ужасе, процессия распадается.
# - Позорная: клюнуть официанта в ногу — он подпрыгивает, тележка катится сама, торт падает на жениха.
#   Подсказка: на ступеньке у двери официант уже спотыкается сам, тележка качается.
# Довезли торт до машины — вспоминают про забытый букет и идут обратно: тупика нет.
# Невидимый «режиссёр»: участники — wed_member, торт — wed_cake.

character procession:
    title "Свадебная процессия"
    preview "wedding.cake_full"
    param x2 "Машина" number step 50 "x свадебной машины — туда везут торт"
    start_x = x
    car_x = x + 4000
    if level.x2 > x: car_x = level.x2
    cx = x
    cart = spawn("wed_cake", cx)
    # Сзади — только официант за тележкой: к его пяткам можно подойти по тротуару
    waiter = join("waiter", -160)
    groom = join("groom", 400)
    join("aunt", 640)
    bride = join("bride", 880)
    join("aunt", 1120)
    car = sprite("wedding", "wedding_car", car_x + 200, ground, depth=DEPTH_GROUND, origin_x=0.5, origin_y=1)

const MARCH_SPEED = 70
# Голубь ближе этого к выходу — процессия выходит из пекарни
const EXIT_NOTICE = 1100
# Рис: над процессией выше этого над тротуаром — сыплют, силы тают столько в секунду
const RICE_HEIGHT = 150
const RICE_DRAIN = 55
const GROOM_REACH = 450
const BRIDE_REACH = 1000
const BOUQUET_G = 1400
const BOUQUET_TIME = 0.9
const ROLL_SPEED = 360

var start_x = 0
var car_x = 0
var cx = 0
var dir = 1
var cart = nil
var car = nil
var members = []
var waiter = nil
var groom = nil
var bride = nil
var bouquet = nil
var bouquet_in = 0
var rice_say = 0
var crowd_cooldown = 0
var roll_v = 0
var wobbled = false

func join(role, slot):
    var m = spawn("wed_member", cx + slot, role=role)
    m.slot = slot
    append members m
    return m

func active():
    return state in [exiting, march, roll]

# Голубь в толпе: от крайнего левого до крайнего правого участника
func span_left():
    var l = cx - 100
    for m in members:
        if m.alive: l = min(l, m.x - 90)
    return l

func span_right():
    var r = cx + 100
    for m in members:
        if m.alive: r = max(r, m.x + 90)
    return r

func sync_cart():
    cart.x = cx
    cart.facing = dir

# Ждёт за дверью пекарни; появился уже за свадьбой (отладка, --x) — её как не было
state waiting:
    every frame:
        if pigeon.x > car_x + 600: go broken
        if pigeon.x > start_x - EXIT_NOTICE: go exiting

state exiting:
    for m in members:
        tween m 0.6 alpha=1
    tween cart 0.6 alpha=1
    banner "Свадьба!" "Испорти торт: три попадания. Сверху не пролететь — тётушки сыплют рис"
    # Ступенька у двери: официант спотыкается, тележка качается — подсказка
    wait 1.0
    wobbled = true
    waiter.stumble()
    tween cart 0.12 angle=6 yoyo=true repeat=3
    wait 1.0
    waiter.go("walk")
    go march

state march:
    every frame:
        formation()
        crowd()
        rice()
        # Жених — за голубем понизу
        if groom.state == "walk" and pigeon.on_ground and abs(pigeon.x - groom.x) < GROOM_REACH: groom.go("chase")
        # Невеста — букетом по летящему
        bouquet_in -= dt
        if bride.state == "walk" and not pigeon.on_ground and abs(pigeon.x - bride.x) < BRIDE_REACH and bouquet == nil and bouquet_in <= 0:
            bouquet_in = 3.5
            bride.go("windup")

# Строй: каждый идёт к своему месту у тележки; занятые своим (бросок, погоня) догоняют потом
func formation():
    cx += dir * MARCH_SPEED * dt
    sync_cart()
    for m in members:
        if not m.alive or m.state != "walk": continue
        var want = cx + m.slot * dir
        if abs(want - m.x) > 4: m.x += sign(want - m.x) * min(abs(want - m.x), (MARCH_SPEED + 160) * dt)
        m.facing = dir
    # Довезли до машины — «букет забыли!», обратно; дошли до пекарни — снова к машине
    if dir > 0 and cx >= car_x - 300:
        dir = -1
        say_at bride.x (bride.y - 440) "Ой! Букет забыли! Все обратно!" 1.8
    elif dir < 0 and cx <= start_x:
        dir = 1

# По тротуару вдоль процессии не пройти: толпа выталкивает к ближнему краю
func crowd():
    crowd_cooldown = max(0, crowd_cooldown - dt)
    if not pigeon.on_ground or pigeon.feet_y < ground - 30: return
    var l = span_left()
    var r = span_right()
    if pigeon.x <= l or pigeon.x >= r or crowd_cooldown > 0: return
    crowd_cooldown = 0.6
    if pigeon.x - l < r - pigeon.x: shove_pigeon (pigeon.x + 60)
    else: shove_pigeon (pigeon.x - 60)
    say_at pigeon.x (ground - 420) pick("Не мешай свадьбе!", "Кыш из-под ног!") 0.8

# Над процессией — рисовое облако: тётушки сыплют вверх, силы тают
func rice():
    rice_say = max(0, rice_say - dt)
    if pigeon.x < span_left() - 120 or pigeon.x > span_right() + 120 or pigeon.feet_y > ground - RICE_HEIGHT: return
    for m in members:
        if m.role != "aunt" or not m.alive or m.state != "walk": continue
        m.go("throw")
        m.face_to_pigeon()
        repeat 4:
            var r = sprite("l1_misc", "fx_rice", m.x + m.facing * 90, m.y - 300, depth=DEPTH_PROJECTILE)
            r.scale = random(0.6, 1.1)
            r.angle = random(360)
            tween r random(0.7, 1.0) x=(pigeon.x + random(-140, 140)) y=(pigeon.feet_y - random(0, 160)) alpha=0 ease="quad_out" kill=true
    pigeon.stamina = max(0, pigeon.stamina - RICE_DRAIN * dt)
    if rice_say <= 0:
        rice_say = 1.2
        popup pigeon.x (pigeon.feet_y - 150) "Рис! Силы тают" "#fff3d6"

# Невеста бросает: туда, где голубь будет через время полёта
func throw_bouquet():
    if bouquet != nil: return
    var sx = bride.x + bride.facing * 120
    var sy = bride.y - 330
    var v = ballistic(sx, sy, pigeon.x + pigeon.vx * BOUQUET_TIME * 0.6, pigeon.feet_y - 50, BOUQUET_TIME, BOUQUET_G)
    bouquet = sprite("wedding", "bride_bouquet", sx, sy, depth=DEPTH_PROJECTILE)
    bouquet.scale = 0.8
    fly bouquet v[0] v[1] BOUQUET_G spin=400
    sfx "whoosh"

func update_bouquet():
    if bouquet == nil: return
    if pigeon_in(bouquet.x - 50, bouquet.y - 50, 100, 100):
        hurt_pigeon bouquet.x
        kill bouquet
        bouquet = nil
        return
    if bouquet.landed:
        bouquet.y = ground - 20
        tween bouquet 0.6 alpha=0 delay=1.5 kill=true
        bouquet = nil

# Попали в торт (от wed_cake)
func cake_hit(hits):
    hit_stop 0.06
    if hits == 1: cart.show("cake_hit_01")
    elif hits == 2: cart.show("cake_hit_02")
    if hits < 3:
        say_at waiter.x (waiter.y - 430) pick("Торт!!!", "Мадам, это крем… просто крем!") 1
        return
    cart.show("cake_ruined")
    spoil(false)

# Официант подпрыгнул — тележка катится сама, вперёд, где жених
func waiter_tripped():
    roll_v = ROLL_SPEED
    go roll

state roll:
    every frame:
        cx += dir * roll_v * dt
        sync_cart()
        # Официант бежит за тележкой
        if waiter.state == "run": waiter.x += dir * 300 * dt
        var gx = groom.x
        if groom.alive and (gx - cx) * dir > -40 and (gx - cx) * dir < 160:
            # Врезалась в жениха: торт — ему на голову
            cart.show("cake_cart")
            var fall = sprite("wedding", "cake_fall", cx, ground - 200, depth=DEPTH_PROJECTILE)
            tween fall 0.35 x=gx y=(ground - 380) angle=40 ease="quad_out" kill=true
            groom.go("caked")
            sfx "smash"
            award 600 "Торт — жениху!" gx (ground - 500)
            deed "wedding_groom"
            spoil(true)
            return
        roll_v = max(0, roll_v - 160 * dt)
        if roll_v <= 0:
            # Жениха впереди не оказалось — торт падает на тротуар
            cart.show("cake_cart")
            sprite("wedding", "cake_pile", cx + dir * 60, ground, depth=DEPTH_BEHIND, origin_x=0.5, origin_y=1)
            sfx "smash"
            spoil(false)
            return

# Свадьба сорвана: кто плачет, кто орёт, тётушки сбегают — улица свободна
func spoil(on_groom):
    if state == broken: return
    if bouquet != nil: kill bouquet
    bouquet = nil
    for m in members:
        if not m.alive: continue
        if m.role == "aunt": m.go("flee")
        elif not (on_groom and m == groom): m.go("panic")
    shake 0.25 0.006
    award 400 "Свадьба сорвана!" cx (ground - 520)
    deed "wedding"
    toast "Свадьба сорвана! Путь свободен"
    go broken

state broken:
    pass

every frame:
    update_bouquet()
