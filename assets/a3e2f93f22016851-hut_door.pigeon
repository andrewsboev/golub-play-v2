# Створка будки — отдельно от кирпичного корпуса. Поворот вокруг правой петли задаёт spec кадров.
character hut_door:
    title "Дверь будки"
    preview "l1_hut_inward.leaf_closed"
    atlas = "l1_hut_inward"
    pose "leaf_closed"
    facing = 1
    depth = -8.95
    hitbox -235 10 0 430
    immune = true
    shadow = 0
    view = sprite("l1_hut_view_lighting", "inside", x - 215, y - 431, depth=-9.5)
    entrance_light = room_light(x - 215, y - 431, 216, 423.45, x - 170, y - 300, 800, "#ffe0ac", 0, "#0c0e12", depth=-9.45)

var opened = false
var view = nil
var entrance_light = nil

func sync_view():
    entrance_light.intensity = 0
    if run_flag("hut_light_on") and not run_flag("hut_bulb_broken"):
        entrance_light.intensity = 1.2

state closed:
    sync_view()
    opened = false
    pose "leaf_closed"

state open:
    pass

func is_open():
    return opened

func finish_open():
    opened = true
    pose "leaf_open"
    go open

func finish_closed():
    opened = false
    pose "leaf_closed"
    go closed

on location_enter(id):
    sync_view()
    if id == "main" and opened: play_cutscene "hut_close"

on location_loaded(id):
    sync_view()
    if id == "main" and opened: play_cutscene "hut_close"

on kick:
    sfx "clink"
    return true
