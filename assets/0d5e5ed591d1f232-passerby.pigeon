# Прохожие (level.kind): клерк с кофе, женщина с мороженым, турист с кренделем в рюкзаке. Ходят туда-сюда,
# иногда заняты своим делом. Облил — кричит, злится и сбегает (кофе, а если попал в рожок — мороженое,
# летит на тротуар). Курлыкнул за спиной или пока занят — вздрагивает и роняет еду. Голубь из газет (§7):
# на «Вредителе» узнают и шарахаются, на «Угрозе» — замахиваются.

import common
import retaliation

character passerby:
    title "Прохожий"
    preview "people.clerk_idle"
    preview "people.ice_idle" if level.kind == "icecream"
    preview "people.tourist_point" if level.kind == "tourist"
    param kind "Кто" choice clerk "Клерк", icecream "С мороженым", tourist "Турист"
    param walk "Участок" range
    atlas = "people"
    say_height = 420
    who = level.kind
    if who == "clerk":
        prefix = "clerk"
        value = 100
        speed = 110
        lines = ["Мой костюм!!!", "Это же Армани!", "Ну за что?!", "У меня совещание!"]
        hitbox -70 70 0 400
        food = "coffee"
        food_line = "Мой кофе!!"
        stand = "clerk_idle"
    elif who == "icecream":
        prefix = "ice"
        value = 50
        speed = 85
        lines = ["Фу-у-у!", "Ну вот…", "Голубь, ты чего?!"]
        # Спереди тело узкое: столбец над рожком свободен, иначе помёт попадает в голову раньше, чем в рожок
        hitbox -60 34 0 380
        food = "ice_cream"
        food_line = "Моё мороженое!"
        stand = "ice_idle"
        # Рожок в руке перед собой, на уровне груди — отдельная мишень
        part "cone" 48 118 190 320
        has_cone = true
    else:
        who = "tourist"
        prefix = "tourist"
        value = 50
        speed = 75
        lines = ["Моя панама!", "Hey! What the…", "Это не входило в экскурсию!"]
        hitbox -70 70 0 370
        # Крендель в рюкзаке: в руках не виден, но с перепугу вываливается
        food = "pretzel"
        food_line = "Мой крендель!"
        stand = "tourist_walk_01"
    if level.facing == 0: facing = pick(-1, 1)
    solid = true
    # Стоит — дышит и косится на голубя (оживший кадр, риги people.clerk_* и др. в assets\meshanim)
    look_at pigeon

# Курлык слышно: по горизонтали и высота голубя над тротуаром (с навеса — не услышат)
const COO_REACH = 360
const COO_HEIGHT = 320
const TOUR_REACH = 1200

var who = ""
var prefix = ""
var value = 0
var speed = 0
var lines = []
var food = ""
var food_line = ""
var stand = ""
var has_cone = false
var hit_by_cone = false
var dropped = false
var recognized = false
var posing = false
var busy_in = random(2.5, 5)
var notice_cooldown = 0
var bob = random(10)
var check_tour = true

state walk:
    play prefix + "_walk"
    every frame:
        x += facing * speed * dt
        if x < level.min_x: facing = 1
        if x > level.max_x: facing = -1
        busy_in -= dt
        if busy_in <= 0: go special
        if not recognized and rank >= RANK_PEST and abs(dx) < 380 and pigeon.on_ground:
            go recognize

# Своё дело: что показывать и сколько секунд
state special:
    var r = random()
    var busy = 1.5
    if who == "clerk":
        if r < 0.45:
            play "clerk_phone"
            busy = 3
        else:
            busy = 1.4
            if r < 0.75: pose "clerk_watch"
            else: pose "clerk_sip"
    elif who == "tourist":
        if r < 0.6:
            # Фотографирует — стоит на месте, очки ×2
            play "tourist_photo"
            posing = true
            busy = 1.8
        else:
            pose "tourist_map"
            busy = 2
    else:
        if r < 0.6: pose "ice_lick"
        else: pose "ice_show"
    wait busy
    posing = false
    busy_in = random(3, 6)
    go walk

state hit:
    pose prefix + "_hit"
    say pick(lines)
    if in_view(): sfx "ouch"
    # Помёт на костюм — клерк роняет кофе; у женщины с мороженым выпадает рожок, только если попал в него
    if who == "clerk" or who == "icecream" and hit_by_cone: drop_food()
    wait 1.1
    go angry

state angry:
    face pigeon
    pose prefix + "_angry"
    wait 0.9
    go flee

state flee:
    play prefix + "_flee"
    run_away(0, 380, 1.2)

# Оборачивается на внезапное «гррру» за спиной, подскок — и роняет еду
state startled:
    face pigeon
    pose stand
    alert true 470
    every frame:
        draw_dy = -sin(pi * min(1, time / 0.22)) * 22
        if time > 0.45:
            drop_food()
            popup x (y - 480) "Врасплох!" "#9be88a"
            say food_line
            if in_view(): sfx "ouch"
            go angry

on leave "startled":
    alert false

# Пинок «кыш»: замах, нога вперёд — голубь отлетает
state kick:
    face pigeon
    play "reactions." + prefix + "_kick"
    wait 0.15
    sfx "swing"
    shove_pigeon from_x=x
    say pick("Кыш!", "Пошёл отсюда!", "Брысь из-под ног!") 0.9
    wait 0.45
    go walk

state notice:
    face pigeon
    pose stand
    say pick("Кыш!", "Кыш отсюда!", "Иди-иди, голубь") 0.9
    notice_cooldown = 3
    wait 0.8
    go walk

state object_revenge:
    posing = false
    retaliate("people." + prefix + "_flee", "reactions." + prefix + "_kick", "people." + stand)
    busy_in = random(3, 6)
    go walk

on weapon_hit(weapon):
    if not light_weapon(weapon): return false
    if state != object_revenge: go object_revenge
    return true

# Узнал голубя по газетам (звание «Районный вредитель» и выше) — один раз
state recognize:
    recognized = true
    face pigeon
    if rank >= RANK_THREAT:
        pose prefix + "_angry"
        say pick("А ну пошёл! Я про тебя в газете читал!", "Это он! Враг города!") 1.3
    else:
        pose stand
        say pick("Это же тот голубь из газеты!", "Ой… это он, тот самый!") 1.3
    var shoved = false
    every frame:
        if rank < RANK_THREAT:
            if time < 0.5: x -= sign(dx) * 160 * dt
        elif time > 0.35 and not shoved:
            shoved = true
            if abs(dx) < 240: shove_pigeon
        if time > 1.2: go walk

func scared():
    return state in [hit, angry, flee, object_revenge]

# Есть что уронить
func has_food():
    return not dropped and (who != "icecream" or has_cone)

func drop_food():
    if dropped: return
    dropped = true
    has_cone = false
    if who == "clerk":
        # Стаканчик падает и кофе растекается — голубь может его выпить
        spawn_food food (x + facing * 80) y
    elif who == "icecream":
        toss_food food (x + facing * 170) from_x=(x + facing * 80) from_y=(y - 260)
    else:
        toss_food food (x + facing * 150) from_x=(x + facing * 40) from_y=(y - 200)

on hit:
    if scared(): return
    var bonus = 1
    if posing: bonus = 2
    score_hit value * bonus
    if bonus > 1: popup x (y - 470) "Попал в кадр!"
    hit_stop 0.04
    go hit

# Голубь подошёл пешком вплотную — отпихивает ногой; в полёте — голубь сам бьётся о него и отлетает (по умолчанию)
on bump(flying, speed):
    if flying or scared(): return false
    if state != kick: go kick
    return true

# Прямо в рожок
on part_hit:
    if scared() or not has_cone: return
    hit_by_cone = true
    score_hit 500
    popup x (y - 480) "Прямо в мороженое!" "#ffb347"
    hit_stop 0.09
    go hit

# Курлыкнул рядом: застал врасплох (занят своим делом или голубь за спиной) — вздрагивает и роняет еду;
# иначе оборачивается и гонит «кыш»
on coo:
    if scared() or state == startled: return
    if abs(dx) > COO_REACH or pigeon.feet_y <= y - COO_HEIGHT: return
    var surprised = state == special or sign(dx) != facing
    if surprised and has_food():
        go startled
    elif state != notice and notice_cooldown == 0:
        go notice

every frame:
    # Турист рядом с экскурсией — уже в её группе (экскурсия ставит своих туристов сама): исчезает до первого кадра
    if check_tour:
        check_tour = false
        for t in actors("tour"):
            if who == "tourist" and abs(t.x - x) < TOUR_REACH:
                vanish
                return
    notice_cooldown = max(0, notice_cooldown - dt)
    part_on "cone" (has_cone and not scared())
    if state == object_revenge: return
    var moving = state == walk or state == flee
    if state == flee: bob += dt * 14
    elif moving: bob += dt * 7
    else: bob += dt * 2
    if moving: draw_dy = -abs(sin(bob)) * 3
    else: draw_dy = 0
    # Первый прохожий с едой на пути — подсказать про курлык (один раз за уровень)
    if pigeon.on_ground and has_food() and not scared() and abs(dx) < 700 and pigeon.feet_y > y - COO_HEIGHT:
        hint_once "coo" "Курлыкни ({coo}) за спиной у прохожего или пока он занят — с перепугу уронит еду"
