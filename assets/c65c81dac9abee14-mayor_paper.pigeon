# Кино «Мэр и газета» (docs/PIGEONSCRIPT.md): камера спускается сверху к мэру на лавке, голубь попадает в газету,
# мэр опускает газету — бешеные глаза, тик, взгляд вверх; голубь на ветке: «Курлык». ~12 с.
# Арт — атласы film_top, film_front, film_low (art/source/film); лица мэра и моргание голубя — накладки
# (arttool.exe faces).
# Проверить: golub.exe --film mayor_paper

film mayor_paper

# Слои, которые двигают несколько событий
var mayor
var drop
var twitch
var up
var paper
var blink

# --- План 1: сверху. Камера на высоте 10: земля 10, мэр на лавке 9.4, ветки 2.4–3.6 (у самой камеры) ---
at 0:
    letterbox true 0
    fade_in 0.8
    shot "top"
    layer "film_top.ground" 10 scale=1.22
    mayor = layer("film_top.mayor", 9.4, x=120, y=30, scale=0.48)
    layer "film_top.branch_a" 3.0 x=-700 y=-330 scale=1.3 angle=-14
    layer "film_top.branch_b" 2.4 x=780 y=300 scale=1.5 angle=24
    layer "film_top.branch_c" 3.6 x=640 y=-360 scale=1.4 angle=-30
    # Спуск: разгон, торможение над газетой и медленный дрейф (камера не встаёт мёртво)
    camera.key 0 z=0 x=0 y=0 roll=-5
    camera.key 4.4 z=4.6 x=110 y=80 roll=0
    camera.key 6.6 z=5.0 x=114 y=84

# Капля: от камеры вниз — уменьшается сама (уходит вглубь), чуть колышется
at 4.75:
    sfx "whistle" 0.8
    drop = layer("film_top.drop_round", 5.05, x=244, y=142, scale=0.27, size_depth=4.53)
    drop.key 4.75 sx=0.92 sy=1.12
    drop.key 5.1 sx=1.05 sy=0.95
    drop.key 5.55 depth=9.38 x=252.5 y=184.7 sx=0.95 sy=1.08 ease="in"

# Шлёп: вспышка удара, шлепок раскрывается с отскоком и оседает, брызги разлетаются
at 5.55:
    drop.kill()
    sfx "splat"
    shake 0.3 12
    var hit = layer("film_top.splat_hit", 9.37, x=252.5, y=184.7, scale=0.18, size_depth=4.53)
    hit.key 5.6 scale=0.3 ease="hold"
    hit.key 5.61 alpha=0
    var full = layer("film_top.splat_full", 9.37, x=252.5, y=184.7, scale=0.12, alpha=0, size_depth=4.53)
    full.key 5.6 alpha=0 ease="hold"
    full.key 5.61 alpha=1
    full.key 5.68 scale=0.36
    full.key 5.82 scale=0.31
    full.key 6.05 alpha=1
    full.key 6.45 alpha=0
    var settled = layer("film_top.splat_settled", 9.37, x=252.5, y=184.7, scale=0.5, alpha=0, size_depth=4.53)
    settled.key 6.05 alpha=0
    settled.key 6.45 alpha=1
    for i in range(6):
        var k = i * 1.047 + 0.3
        var d = layer("film_top.droplet_" + str(i + 1), 9.36, x=252.5, y=184.7, scale=0.25, size_depth=4.53)
        d.key 5.95 x=252.5 + cos(k) * 70 y=184.7 + sin(k) * 55 alpha=0 ease="out"
    # Мэр вздрагивает
    mayor.key 5.55 sx=1 sy=1
    mayor.key 5.62 sx=1.012 sy=0.975
    mayor.key 5.85 sx=1 sy=1

# --- План 2: мэр спереди. Фон 20, мэр 10, лица поверх (9.99), газета 9.8 ---
at 6.6:
    shot "front"
    layer "film_front.bg" 20 scale=1.22
    layer "film_front.mayor" 10 y=20 scale=1.13
    twitch = layer("film_front.face_twitch", 9.99, y=20, scale=1.13, alpha=0)
    up = layer("film_front.face_up", 9.99, y=20, scale=1.13, alpha=0)
    paper = layer("film_front.paper", 9.8, y=-190, scale=0.45)
    # Газета медленно опускается — глаза поверх неё
    paper.key 7.3 y=-190
    paper.key 8.7 y=-40
    # Медленный наезд с постоянной скоростью: склейки по краям прячут начало и конец
    camera.key 6.6 z=0 x=-10 ease="linear"
    camera.key 10.4 z=0.9 x=10

# Тик глаза — дважды
at 8.95:
    sfx "tick"
    twitch.key 8.95 alpha=0 ease="hold"
    twitch.key 8.96 alpha=1 ease="hold"
    twitch.key 9.05 alpha=0
at 9.2:
    sfx "tick"
    twitch.key 9.2 alpha=0 ease="hold"
    twitch.key 9.21 alpha=1 ease="hold"
    twitch.key 9.3 alpha=0

# Глаза закатываются вверх — щелчком, как в мультфильме (наплыв дал бы две пары глаз)
at 9.6:
    up.key 9.6 alpha=0 ease="hold"
    up.key 9.61 alpha=1

# --- План 3: снизу вверх. Небо с веткой 30, голубь на ветке ---
at 10.4:
    shot "low"
    layer "film_low.sky" 30 scale=1.22
    layer("film_low.pigeon", 29.9, x=80, y=10, scale=0.55)
    blink = layer("film_low.pigeon_blink", 29.89, x=80, y=10, scale=0.55, alpha=0)
    camera.key 10.4 zoom=1 y=12 ease="linear"
    camera.key 12.4 zoom=1.08 y=0

# Довольный голубь моргает
at 11.3:
    blink.key 11.3 alpha=0 ease="hold"
    blink.key 11.31 alpha=1 ease="hold"
    blink.key 11.45 alpha=0

at 10.95:
    sfx "coo"

at 11.8:
    fade_out 0.6

at 12.45:
    end_film
