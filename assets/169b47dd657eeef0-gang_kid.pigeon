# Ребёнок из банды у рынка (gang.pigeon создаёт троих: role cap, girl, beanie). Кепка с сачком, девочка-
# наводчица, шапка с рогаткой. Общее — тревога, камни и сачок — у «режиссёра» банды (parent).

import common

character gang_kid:
    preview "kids.kid_girl_idle"
    preview "gang.beanie_aim_01" if level.role == "beanie"
    preview "gang.cap_net_walk" if level.role == "cap"
    atlas = "gang"
    role = level.role
    gang = parent
    has_net = role == "cap"
    facing = -1
    hitbox -80 80 0 310
    say_height = 340
    death_line = "Голубь пал от рогатки. Дети гордятся"

const AIM_TIME = 0.75
const SHOT_COOLDOWN = 2.0
# Сачок накрывает на этом расстоянии перед кепкой
const NET_REACH = 280

var role = ""
var gang = nil
var has_net = false
var aim_x = 0
var aim_y = 0
# Прицел задан заранее (первый выстрел — мимо, над своими), а не ведёт голубя
var fixed_aim = false
var cooldown = 2
var bob = random(10)

func gone():
    return state in [cower, flee] or not alive

func calm():
    return state in [idle, alert]

func aim_at(tx, ty, fixed):
    aim_x = tx
    aim_y = ty
    fixed_aim = fixed
    go aim

# Прилетело камнем от своего
func stone_hit():
    if gone() or gang.done: return
    go hit
    gang.start_quarrel(self)

# Сачок падает и остаётся лежать, поблёскивая
func drop_net():
    var n = sprite("l1_misc", "item_net", x + facing * 60, y - 200, depth=DEPTH_BEHIND, origin_x=0.5, origin_y=1)
    n.angle = -40
    n.outline = 2
    tween n 0.45 x=(x + facing * 200) y=(ground + 4) angle=0 ease="quad_out"

# Стоит или поднимает тревогу: каждый — своё дело
func think():
    if not gang.started: return
    face pigeon
    var d = (pigeon.x - x) * facing
    if role == "girl":
        if state == idle:
            if cooldown <= 0:
                cooldown = random(3, 5)
                go alert
        elif time > 1.4:
            go idle
    elif role == "beanie":
        # Целится туда, где голубь будет к выстрелу
        if cooldown <= 0 and not pigeon.dead and not pigeon.hidden and abs(dx) < 1300:
            aim_at(pigeon.x + pigeon.vx * 0.25, pigeon.feet_y - 50, false)
    elif role == "cap":
        if has_net and pigeon.on_ground and not pigeon.hidden and d > 20 and d < NET_REACH + 40 and cooldown <= 0 and not gang.caught:
            go raise
        elif has_net and cooldown <= -3:
            cooldown = 0
            go pour

state idle:
    if role == "girl":
        atlas = "kids"
        play "girl_idle"
    elif role == "cap":
        if has_net:
            pose "cap_net_walk"
        else:
            atlas = "kids"
            pose "kid_cap_idle"
    else:
        pose "beanie_aim_01"
    every frame:
        think()

state alert:
    face pigeon
    pose pick("girl_whistle", "girl_yell")
    say pick("Вон он! Держи голубя!", "Пацаны, голубь!") 1.2
    if in_view(): sfx "alarm"
    every frame:
        think()

state aim:
    face_to aim_x
    pose "beanie_aim_02"
    every frame:
        # Прицел ведёт голубя, но не до самого выстрела: последние 0.2 с — уже не довернёт
        if not fixed_aim and time < AIM_TIME - 0.2:
            aim_x = pigeon.x + pigeon.vx * 0.25
            aim_y = pigeon.feet_y - 50
        if time >= AIM_TIME: go shoot

state shoot:
    pose "beanie_shoot"
    gang.shoot(self, aim_x, aim_y, fixed_aim)
    wait 0.35
    fixed_aim = false
    cooldown = SHOT_COOLDOWN
    go idle

state pour:
    face pigeon
    pose "cap_net_raise"
    spawn_food "crumbs" (x + facing * random_int(170, 230)) ground
    wait 0.6
    cooldown = 1
    go idle

state raise:
    face pigeon
    pose "cap_net_raise"
    say "Цып-цып-цып…" 0.7 360
    wait 0.45
    go slam

state slam:
    pose "cap_net_slam"
    sfx "swing"
    var d = (pigeon.x - x) * facing
    if pigeon.on_ground and d > 20 and d < NET_REACH and not gang.caught: gang.catch()
    else: say "Мимо!" 0.7
    wait 0.5
    cooldown = 2.5
    go idle

state hop:
    pose "cap_hop"
    has_net = false
    drop_net()
    say "Ай! Мой сачок!" 1 360
    if in_view(): sfx "ouch"
    award 120 "Сачок выбит!" x (y - 380)
    wait 0.8
    cooldown = 2
    go idle

state hit:
    if role == "cap": pose "cap_hit"
    elif role == "beanie": pose "beanie_hit"
    else: pose "girl_yell"
    if in_view(): sfx "ouch"
    wait 0.9
    go yell

state yell:
    if role == "cap": pose "cap_yell"
    elif role == "beanie": pose "beanie_yell"
    else: pose "girl_laugh"
    wait until time > 2.2 and gang.done
    go flee

state cower:
    atlas = "kids"
    play role + "_cower"
    say pick("Фууу!", "Мамааа!", "Он насрал на меня!") 1.4 300
    if in_view(): sfx "eww"
    wait 1.2
    go flee

# Убегают с арены — в сторону от голубя
state flee:
    atlas = "kids"
    play role + "_walk"
    run_away(0, 430, 1.3)
    gang.kid_gone()

on leave:
    atlas = "gang"

on hit:
    if gone() or gang.done: return
    score_hit 70
    hit_stop 0.04
    go cower

# Кепку — в ногу: подпрыгнет и выронит сачок. Остальные — отгоняют
on peck:
    if gone() or gang.done: return false
    if role == "cap" and has_net and state != slam:
        go hop
        return true
    say pick("Отвали, голубь!", "Он кусается!") 0.9
    if abs(dx) < 220: shove_pigeon
    return true

every frame:
    if gang.done and not state in [flee, yell, hit, cower]: go flee
    cooldown -= dt * gang.anger()
    immune = gone() or gang.done
    if state == flee:
        bob += dt * 14
        draw_dy = -abs(sin(bob)) * 8
    else:
        bob += dt * 2.2
        draw_dy = sin(bob) * 1.5
    # Прицел рогатки — мигающее перекрестие там, куда упадёт камень
    if state == aim and not fixed_aim: crosshair aim_x aim_y
    else: overlay_off
