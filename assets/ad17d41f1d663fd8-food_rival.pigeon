# Конкурент за еду. Добычу, ключи и кости вокруг не удаляет; спор идёт за отдельную общую порцию.

character food_rival:
    title "Голубь конкурент"
    preview "ambient.flock_brown_idle"
    param walk "Зона кормёжки" range
    atlas = "ambient"
    pose "flock_brown_idle"
    visible = false
    immune = true
    shadow = 70
    home_x = x

var home_x = 0
var started = false
var done = false
var peck_in = 0

state waiting:
    visible = false
    every frame:
        if abs(pigeon.x - home_x) < 650: reveal_objective "meal"

state arrive:
    visible = true
    face -1
    play "brown_fly"
    every frame:
        x = home_x + max(0, 500 * (1 - time / 1.2))
        draw_dy = -max(0, 260 * (1 - time / 1.2))
        if time >= 1.2: go ready

state ready:
    x = home_x
    draw_dy = 0
    pose "flock_brown_idle"
    every frame:
        if abs(dx) < 550 and pigeon.on_ground and feeding_start():
            started = true
            lock_arena "feeding" (home_x - 650) (home_x + 650)
            go compete

state compete:
    every frame:
        face pigeon
        peck_in = floor(time * 4.0 * 4) % 4
        if peck_in == 0: pose "flock_brown_idle"
        elif peck_in == 1 or peck_in == 3: pose "flock_brown_peck_01"
        else: pose "flock_brown_peck_02"
        if floor(time * 4.0) != floor((time - dt) * 4.0):
            if in_view(): sfx "peck"

state leave:
    face 1
    play "brown_fly"
    every frame:
        x += 320 * dt
        draw_dy -= 210 * dt
        if time > 2: vanish

on food_pecked(food, fx, fy):
    if done or started or state != waiting: return
    if abs(fx - home_x) < 450 and abs(fy - y) < 150: go arrive

on feeding_finished(result, player, rival):
    if not started or done: return
    done = true
    release_arena "feeding"
    if result == "win": toast "Переклевал! Большая часть еды — твоя"
    elif result == "draw": toast "Поровну! Никто не уступил"
    else:
        toast "Не успел! Запыхался, но поел"
        pigeon.fatigue = 20
    var portions = round(10 * feeding_share())
    for i in range(portions):
        toss_food "crumbs_pile" (home_x - 250 + i * 55) from_x=home_x from_y=(y - 90)
    broadcast "rival_finished" result
    go leave

on death:
    if done: return
    feeding_reset
    release_arena "feeding"
    started = false
    x = home_x
    draw_dy = 0
    go waiting
