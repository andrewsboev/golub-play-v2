# Турист экскурсии (tour.pigeon создаёт троих): hawaiian — тот самый в гавайке, с хот-догом; selfie — с палкой
# для селфи (снимает спиной к голубю: тот должен попасть в кадр за её плечом); polaroid — дедушка с «Полароидом»
# (целится дольше всех, после вспышки ждёт карточку). Когда и кому снимать, решает «режиссёр» (parent).

import common

character tourist:
    preview "people.tourist_map"
    role = level.role
    tour = parent
    if role == "hawaiian": base_atlas = "people"
    else: base_atlas = "tour"
    atlas = base_atlas
    facing = -1
    hitbox -70 70 0 380
    solid = true
    say_height = 450
    hot_dog = role == "hawaiian"
    look_at pigeon
    death_line = "Голубь ослеп от вспышек. Туристы довольны снимками"

const DIVE_TIME = 0.4

var role = ""
var tour = nil
var base_atlas = ""
var hot_dog = false
var dropped = false
# Снимок для проверки пролёта: быстрый, без позирования
var quick = false
var good = false
# Место в погоне за платком: насколько отстаёт от голубя
var lag = 0
var bob = random(10)

# Кадры ролей; у туриста в гавайке — старые кадры из атласа people плюс новые. Погоня и фонтан — атлас tour2
func f(which):
    if role == "hawaiian":
        if which == "idle":
            if hot_dog: return "tourist_eat"
            return "tourist_map"
        if which == "raise": return "tourist_photo_raise"
        if which == "aim": return "tourist_photo_aim"
        if which == "flash": return "tourist_photo_flash"
        if which == "good": return "tourist_check_good"
        if which == "bad": return "tourist_check_bad"
        if which == "ruined": return "tourist_wipe"
        if which == "chase": return "tourist_map"
        return "tourist_" + which
    if role == "selfie":
        if which in ["idle", "point", "bad"]: return "selfie_idle"
        if which == "raise":
            if quick: return "selfie_aim"
            return "selfie_raise"
        if which == "aim":
            if quick: return "selfie_aim"
            return "selfie_pose"
        if which in ["good", "clap"]: return "selfie_clap"
        if which == "ruined": return "selfie_dirty"
        return "selfie_" + which
    if which in ["idle", "point"]: return "polaroid_walk_01"
    if which == "good": return "polaroid_admire"
    if which == "bad": return "polaroid_angry"
    return "polaroid_" + which

func raise_time():
    if quick: return 0.12
    if role == "hawaiian": return 0.35
    if role == "selfie": return 0.4
    return 0.5

# Прицеливание — окно, за которое голубь успевает встать в рамку (или облить снимающего); у дедушки оно самое
# длинное
func aim_time():
    if quick: return 0.28
    if role == "hawaiian": return 0.85
    if role == "selfie": return 1.05
    return 1.3

func scared():
    return state in [hit, angry, flee, ruined, hop]

func shooting():
    return state in [raise, aim, flash, after, result]

func chasing():
    return state in [chase, dive, splash, giveup]

func busy():
    return scared() or shooting() or chasing()

# Где камера (вспышка)
func camera_point():
    if role == "selfie":
        if quick: return [x + facing * 150, y - 300]
        return [x + facing * 110, y - 420]
    if role == "polaroid": return [x + facing * 110, y - 300]
    return [x + facing * 95, y - 310]

func shoot(q):
    quick = q
    go raise

func splash_fx():
    var s = sprite("l1_misc", "fx_splash_big", x, y, depth=DEPTH_PROJECTILE, origin_x=0.5, origin_y=1)
    s.scale = 0.6
    tween s 0.5 scale=1.1 alpha=0 ease="cubic_out" kill=true

state idle:
    facing = -1
    pose f("idle")

state point:
    facing = -1
    pose f("point")
    if role == "hawaiian": say "Смотрите, голубь!!!"
    wait 1.6
    go idle

# Селфи — спиной к голубю: он должен попасть в кадр за её плечом
state raise:
    face pigeon
    if role == "selfie" and not quick: facing = -facing
    pose f("raise")
    wait raise_time()
    go aim

state aim:
    pose f("aim")
    sfx "focus"
    every frame:
        tour.aiming(min(1, time / aim_time()))
        if time >= aim_time(): go flash

state flash:
    pose f("flash")
    tour.flash(self)
    wait 0.22
    if role == "polaroid" and not quick: go after
    go result

# Дедушка ждёт, пока вылезет карточка, и трясёт её
state after:
    pose "polaroid_eject"
    wait 0.45
    pose "polaroid_shake"
    wait 0.45
    go result

state result:
    if good: pose f("good")
    else: pose f("bad")
    if not good and not quick:
        if role == "polaroid": say "Опять засветил…" 1
        elif role == "selfie": say "Голубь не влез!" 1
        else: say "Эх, упустил!" 1
    if quick: wait 0.3
    else: wait 0.9
    tour.shot_done(self)
    go idle

state kick:
    face pigeon
    play "reactions.tourist_kick"
    wait 0.15
    sfx "swing"
    shove_pigeon from_x=x
    say pick("Не лезь в кадр!", "Кыш, не мешай!", "Get out of my shot!") 0.9
    wait 0.45
    go idle

state look:
    facing = 1
    pose f("idle")

state hit:
    pose f("hit")
    if role == "polaroid": say pick("Моя панама!", "В мои-то годы!") 1.4 440
    elif role == "selfie": say pick("Мои волосы!!!", "Это в сторис не пойдёт!") 1.4 440
    else: say pick("Это не входило в экскурсию!", "Моя панама!") 1.4 440
    if in_view(): sfx "ouch"
    # С перепугу роняет перекус — один раз
    if not dropped:
        dropped = true
        if role == "selfie": spawn_food "pretzel" (x - facing * 90) y
        if role == "polaroid": spawn_food "seeds" (x - facing * 90) y
    tour.shot_done(self)
    wait 1.1
    go angry

# Испорченный кадр: облитая камера, телефон, карточка
state ruined:
    atlas = "tour2"
    pose f("ruined")
    if role == "polaroid": say "Карточка испорчена!"
    elif role == "selfie": say "Мой телефон!!! Фу!!!"
    else: say "Объектив! Мой объектив!"
    if in_view(): sfx "ouch"
    wait 1.6
    go angry

state angry:
    face pigeon
    pose f("angry")
    wait 0.8
    go idle

state hop:
    pose f("angry")
    say pick("Ай! Он кусается!", "Кыш, кыш!") 0.9
    if abs(dx) < 220: shove_pigeon
    wait 0.7
    go idle

state flee:
    play f("flee")
    run_away(1, 380, 1.2)

state chase:
    atlas = "tour2"
    pose f("chase")

# Рыбкой — к фонтану, по дуге
state dive:
    atlas = "tour2"
    pose f("dive")
    say pick("Платок!", "А-а-а!", "Держи его!") 0.8 300
    var from = x
    every frame:
        var k = min(1, time / DIVE_TIME)
        x = from + (tour.fountain_x + (lag - 470) * 0.3 - from) * k
        draw_dy = -sin(k * pi) * 70
        if time >= DIVE_TIME: go splash

state splash:
    atlas = "tour2"
    pose f("splash")
    draw_dy = 0
    splash_fx()
    if in_view(): sfx "ouch"
    tour.splash(self)

state giveup:
    atlas = "tour2"
    pose f("chase")
    wait 1.5
    go flee

on leave:
    atlas = base_atlas

# Подошёл пешком под ноги — отпихивает ногой (в полёте голубь сам бьётся и отлетает). Пинок нарисован только у
# туриста в гавайке и только не посреди съёмки; остальные просто отпихивают
on bump(flying, speed):
    if flying or scared() or chasing(): return false
    if state == kick: return true
    if role == "hawaiian" and state == idle:
        go kick
        return true
    face pigeon
    sfx "swing"
    shove_pigeon from_x=x
    say pick("Не лезь в кадр!", "Кыш, не мешай!", "Get out of my shot!") 0.9
    return true

# Облил, пока целится, — фотобомба: кадр испорчен. Просто облил — утирается, злится и снова снимает
on hit:
    if immune or state in [hit, ruined]: return
    if chasing():
        score_hit 40
        return
    if state in [raise, aim] and not quick:
        score_hit 120
        popup x (y - 480) "Фотобомба!"
        hit_stop 0.06
        go ruined
        tour.photobomb(self)
        return
    score_hit 60
    hit_stop 0.04
    go hit

# Клюнул: у гавайки — вырвать хот-дог из рук; остальных — в ногу: подпрыгнет и отгонит
on peck:
    if chasing() or state in [flee, hop]: return false
    if hot_dog and not shooting():
        hot_dog = false
        spawn_food "hot_dog" (pigeon.x + pigeon.facing * 50) ground
        award 80 "Вырвал хот-дог!" x (y - 420)
        say pick("Мой хот-дог!", "Эй! Я за него заплатил!") 1.3
        if state == idle: pose f("idle")
        return true
    go hop
    return true

every frame:
    immune = state in [flee, splash, dive]
    if state == flee:
        bob += dt * 14
        draw_dy = -abs(sin(bob)) * 6
    elif state == chase:
        bob += dt * 9
        draw_dy = -abs(sin(bob)) * 6
    elif state != dive and state != splash:
        bob += dt * 2
        draw_dy = sin(bob) * 1.5
