# Предметы «домашней территории» уровня 1 (урна, мешки, банки, щиток): общее. Новый арт — атлас l1_home;
# пока его нет, предмет показывает замену из старых атласов.

# Кадр frame атласа atl, а пока его нет — fb_frame атласа fb_atlas. Атлас задаёт и то, что предмет — не
# невидимый «режиссёр»: в него попадает помёт и пинок.
func show(atl, frame, fb_atlas, fb_frame):
    if has_frame(atl + "." + frame):
        atlas = atl
        pose frame
    else:
        atlas = fb_atlas
        pose fb_frame

# Качнулся от удара: сплющился и выпрямился
func wobble():
    stop_tweens self
    scale_y = 1
    tween self 0.07 scale_y=0.9 yoyo=true

# Куда отлетает от голубя: от него в сторону (стоит вплотную — по взгляду голубя)
func away():
    var d = sign(x - pigeon.x)
    if d == 0: d = pigeon.facing
    return d

# Голубь рядом — показать дело в «Голубиных делах» (без спойлеров: только когда подошёл к вещи)
func reveal_near(id, reach):
    if abs(pigeon.x - x) < reach: reveal_objective id
