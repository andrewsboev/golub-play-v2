# Добрая бабушка на скамейке: сыплет голубям семечки. Её обсирать нельзя — штраф и обида надолго.
# Подошёл к ней пешком — гладит, голубь урчит.

character feeder:
    title "Добрая бабушка"
    preview "people.grandma_idle_01"
    param lift "Подъём" number step 5 "Выше линии ног, px (сидит на скамейке)"
    atlas = "people"
    depth = DEPTH_BEHIND
    hitbox -90 90 0 290
    # Голубь сквозь неё не проходит — подходит вплотную
    solid = true
    # Сидит: поворачивается на лавке, а не пересаживается
    turn_in_place = true
    # Сидит лицом вперёд, юбка и сумка свисают назад — тело шире сзади
    body -125 90 0 250
    say_height = 320
    # Сидит и дышит (оживший кадр — риг grandma_idle_01), головой следит за голубем
    look_at pigeon

# Сколько несъеденных семечек может лежать возле неё
const MAX_SEEDS = 2

var feed_in = 1.5
# Погладила — до следующего раза не меньше стольких секунд
var pet_in = 0

# Сердечко над голубем: поднимается и тает
func heart(dx_, delay):
    var h = sprite("ui", "ui_icon_heart", pigeon.x + dx_, pigeon.feet_y - 120, depth=DEPTH_ALERT)
    h.scale = 0.5
    h.alpha = 0
    tween h 0.15 alpha=1 delay=delay
    tween h 1.1 y=(pigeon.feet_y - 240) delay=delay ease="sine_out"
    tween h 0.4 alpha=0 delay=(delay + 0.7) kill=true

state idle:
    pose "grandma_idle_01"
    every frame:
        pet_in = max(0, pet_in - dt)
        # Голубь стоит вплотную (упёрся в тело — его держат на ~30 px от края тела) — погладить, с какой стороны ни подошёл
        if pet_in == 0 and pigeon.on_ground and touches_pigeon(-175, 140, 0, 250):
            go pet
        feed_in -= dt
        if feed_in <= 0 and abs(dx) < 1400 and food_near(x + facing * 240, 260) < MAX_SEEDS:
            go throw
        if feed_in <= 0:
            feed_in = 1

state throw:
    play "grandma_throw"
    wait 0.5
    toss_food "seeds" (x + facing * random_int(160, 320)) from_x=(x + facing * 90) from_y=(y - 170)
    feed_in = random(3.5, 5.5)
    go idle

# Обиделась надолго: семечек не будет
state offended:
    pose "grandma_offended"
    say pick("Ох… а я тебя кормила…", "За что ж ты так…") 1.8
    toast "Это была добрая бабушка. Стыдно! −100"
    wait 15
    feed_in = 2
    go idle

# Гладит голубя: тянется рукой, гладит, приговаривает; голубь зажмурился и урчит, над ним — сердечки
state pet:
    face pigeon
    pose "reactions.grandma_pet_01"
    pigeon.purr = 2.6
    sfx "purr"
    wait 0.35
    play "reactions.grandma_pet"
    heart(-20, 0)
    heart(25, 0.45)
    wait 1.4
    pose "reactions.grandma_pet_03"
    say pick("Ах ты мой хороший…", "Гули-гули, мой хороший…", "Ну иди, иди сюда, маленький") 1.6
    wait 1.0
    pet_in = 8
    go idle

on hit:
    if state == offended: return
    penalty 100
    go offended
