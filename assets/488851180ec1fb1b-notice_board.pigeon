# Доска объявлений в парке (уровень 1, экран 2): плакаты администрации «ГОЛУБЯМ ЗДЕСЬ НЕ МЕСТО» и «НЕ КОРМИТЕ
# ВРЕДИТЕЛЕЙ» — мэрская кампания добралась и сюда. Насрать на плакаты — ответить мэрии: доска становится
# обосранной (кадр board_pooped). Во время боя с жирдяем (арена «park») доска не мишень.

import props

character notice_board:
    title "Доска объявлений"
    preview "l1_park.board_clean"
    preview "style_park.park_signpost"
    show("l1_park", "board_clean", "style_park", "park_signpost")
    hitbox -230 230 90 494
    shadow = 0

var pooped = false

state stand:
    pass

every frame:
    reveal_near("park_poster", 600)
    # Во время боя с жирдяем доска не мишень — помёт пролетает к нему, а не на плакат
    immune = in_arena("park")

on hit:
    if pooped:
        score_hit 10 hx hy
        return
    pooped = true
    if has_frame("l1_park.board_pooped"): pose "l1_park.board_pooped"
    award 150 "Ответ мэрии!" x (y - 560)
    objective "park_poster"

on peck:
    say_at x (y - 560) "ГОЛУБЯМ ЗДЕСЬ НЕ МЕСТО" 1.6
    return true
