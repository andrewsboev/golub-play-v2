# Двор пса (level1_old, экран 8) — событие без стен: над двором низко идут трубы, поверху не
# пролететь, проход — только мимо пса. Пёс сторожит открытый мусорный бак, на краю бака — веточка для гнезда.
# - Обычная победа: оглушить пса помётом, выхватить веточку и бежать — пёс гонится до самого гнезда (x2).
# - Позорная: заманить пса в открытый бак — крышка захлопывается. Подсказка: в начале пёс сам кидается
#   на бак, крышка шатается и хлопает.
# Сам бак — картинка; персонаж «trap» невидимый.

character trap:
    title "Бак-ловушка"
    preview "l1_misc.trap_open"
    param x2 "Гнездо" number step 50 "x гнезда — с веточкой пёс гонится до него"
    can = sprite("l1_misc", "trap_open", x, ground, depth=DEPTH_GROUND, origin_x=0.5, origin_y=1)
    nest_x = level.x2
    # Край бака — на нём можно стоять
    add_perch (x - 190) (ground - RIM) 380

# Край открытого бака над тротуаром: на нём лежит веточка
const RIM = 240
# Пёс влетает в бак, если падает в прыжке над его серединой не дальше этого
const CATCH = 150

var can = nil
var nest_x = 0
var dog = nil
var bangs = 0
var bang_in = 0
var bark_in = 0
var chase_said = false

# Крышка шатается и хлопает
func bang():
    bangs += 1
    stop_tweens can
    can.angle = 0
    var a = -3
    if bangs % 2 == 1: a = 3
    tween can 0.07 angle=a yoyo=true repeat=2
    say_at x (ground - 420) "БАМ!" 0.5
    if abs(x - pigeon.x) < 1200: sfx "smash"

state watch:
    every frame:
        # Бак сторожит сторожевой пёс, на чьём участке он стоит
        if dog == nil:
            for d in actors("dog"):
                if not d.sleep_mode and d.min_x <= x and d.max_x >= x: dog = d
            continue
        # Подсказка: пёс, заметив голубя у бака, с разбегу бьётся о бак — крышка хлопает
        if bangs < 2 and (dog.state == "bark" or dog.state == "run") and abs(dog.x - x) < 500:
            bang_in -= dt
            if bang_in <= 0:
                bang()
                bang_in = 0.35
        # Прыгнул за голубем и падает прямо в открытый бак
        if dog.alive and dog.state == "leap" and dog.vy > 0 and abs(dog.x - x) < CATCH and dog.y > ground - RIM - 40:
            dog.trapped()
            can.frame = "l1_misc.trap_closed"
            bang()
            shake 0.2 0.006
            award 600 "Пёс в баке!" x (ground - 460)
            deed "dog_trap"
            bark_in = 0.6
            go caught
        # Веточка у голубя — пёс гонится до самого гнезда
        if pigeon.carrying and dog.alive and nest_x > dog.max_x:
            dog.max_x = nest_x + 150
            if not chase_said:
                chase_said = true
                toast "Пёс гонится! Неси веточку в гнездо — повыше!"

# Пёс внутри: крышка прыгает, из-под неё лает
state caught:
    every frame:
        bark_in -= dt
        if bark_in <= 0:
            bark_in = random(0.9, 1.6)
            if round(bark_in * 10) % 2 == 1: can.frame = "l1_misc.trap_dog_01"
            else: can.frame = "l1_misc.trap_dog_02"
            tween can 0.08 scale_y=1.04 yoyo=true
            say_at x (ground - 380) "Гав?! ГАВ!!!" 0.7
