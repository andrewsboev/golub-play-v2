# Бабка — босс уровня 1 (двор пекарни, level1_old). Ходит за голубем, бьёт газетой (сбоку и
# сверху), кричит (волна сбивает с карниза), с разбега таранит; во второй фазе кидает батон, в третьей
# соседка из окна выливает таз. Терпение — 3: по голове в окне уязвимости (выдохлась, газета застряла,
# облили, отбивается от стаи) — целое сердечко, вне окна — половинка. Свергнут Пахан — стая один раз
# налетит на неё. Сценарий уровня (level1.pigeon) зовёт start(), celebrate(), reset().

character granny:
    title "Бабка (босс)"
    preview "granny.granny_idle_01"
    param x2 "Окно соседки" number step 10 "x окна, откуда соседка выливает таз (третья фаза); 0 — нет"
    param walk "Участок" range
    param mode "Вариант боя" choice "" "Прежний босс", street "Уличная встреча"
    street_mode = level.mode == "street"
    patience = max_patience()
    atlas = "granny"
    facing = -1
    spawn_x = x
    min_x = level.min_x
    max_x = level.max_x
    # Окно соседки с тазом (третья фаза); 0 — соседки нет
    window_x = level.x2
    hitbox -100 100 160 420
    death_line = "Местного голубя прихлопнули газетой. Никто не скорбит"

const PATIENCE = 3
const WALK_SPEED = 130
const RUN_SPEED = 300
const CHARGE_SPEED = 600
const CHARGE_WINDUP = 1.0
# Окно уязвимости (с каждой потерей терпения — на 0.3 с короче)
const TIRED_TIME = 3.5
# Сколько голубь может сидеть вне досягаемости, прежде чем бабка его сгонит криком
const HIGH_PATIENCE = 2.6
# Сколько терпения снимает попадание вне окна усталости
const GRAZE_DAMAGE = 0.5
const GRAZE_COOLDOWN = 0.8
# Таз соседки: подоконник над тротуаром, ширина струи, струя правее середины окна (так нарисован кадр)
const SILL = 868 - 270
const POUR_W = 130
const POUR_DX = 95
const BAG_GRAVITY = 1500

var street_mode = false
var knock_guard = 0
var hurt_flash = 0
var was_hurt = false
var patience = 3
var spawn_x = 0
var min_x = 0
var max_x = 0
var window_x = 0
var attacks = 0
var high_time = 0
var overhead = false
var strike_hit = false
var shown_tired_hint = false
var breath_timer = 0
var say_cooldown = 0
var graze_cooldown = 0
# Батон в полёте; соседка в окне и вода из таза
var bag = nil
var bag_cooldown = 0
var neighbour = nil
var pour = nil
var basin_in = 4
var basin_t = 0
var basin_phase = 0
var basin_done = false
var flock_used = false
var ml_enabled = false
var ml_action = 0

# Сценарий определяет допустимость; обе политики используют те же боевые состояния.
func ml_mask():
    var ready = state in [approach, policy]
    return [true, ready, ready, ready, ready and reachable() and abs(dx) < 380,
        ready, ready and patience < PATIENCE and abs(dx) > 400,
        ready and patience <= 2 and bag_cooldown <= 0 and abs(dx) > 380 and abs(dx) < 1100]

func ml_begin():
    ml_action = 0
    go approach

# --- Что зовёт сценарий уровня ---

func max_patience():
    if street_mode: return 8
    return PATIENCE

func start():
    if state == waiting: go intro

func celebrate():
    if state != defeated: go victory

func reset():
    patience = max_patience()
    if street_mode: baton_clear
    knock_guard = 0
    attacks = 0
    x = spawn_x
    facing = -1
    flock_used = false
    basin_in = 4
    basin_phase = 0
    if bag != nil: kill bag
    if neighbour != nil: kill neighbour
    if pour != nil: kill pour
    bag = nil
    neighbour = nil
    pour = nil
    overlay_off
    go waiting

func is_defeated():
    return state == defeated

func engaged():
    return state != waiting

# --- Правила боя ---

# Множитель скорости: чем меньше терпения, тем злее
func speed():
    if street_mode: return 1 + 0.08 * (8 - patience)
    return 1 + 0.25 * (PATIENCE - patience)

# Сколько атак до отдыха: в первой фазе — одна, потом две
func attacks_before_rest():
    if patience == max_patience(): return 1
    return 2

func tired_time():
    if street_mode: return TIRED_TIME
    return TIRED_TIME - 0.3 * (PATIENCE - patience)

# Окна, когда по голове — целое сердечко: выдохлась, газета застряла, облили, отбивается от стаи
func vulnerable():
    return state in [tired, stuck, wet, cover]

func window_time():
    if state == stuck: return tired_time() * 1.7
    if state == wet: return tired_time() * 1.6
    if state == cover: return tired_time() * 1.2
    return tired_time()

func walk_toward(target, spd):
    face_to target
    var d = target - x
    x += sign(d) * min(abs(d), spd * dt)
    x = clamp(x, min_x, max_x)

# Голубь достаточно низко, чтобы его достать газетой сверху
func reachable():
    return pigeon.feet_y > y - 600

# Удар: проверяет хитбокс один раз за атаку
func swat(f0, f1, u0, u1):
    if strike_hit or not touches_pigeon(f0, f1, u0, u1): return
    strike_hit = hurt_pigeon()

func after_attack():
    attacks += 1
    if attacks >= attacks_before_rest(): go tired
    go approach

func dust_at_feet(scale):
    dust scale (x - facing * 60) y

# Крик: волна вперёд, сбивает голубя с карниза
func shout_wave():
    ring (x + facing * 120) (y - 360) 40 900 0.65
    shake 0.26 0.006
    var d = dx
    if (sign(d) == facing or abs(d) < 260) and abs(d) < 950: shove_pigeon

# Окно уязвимости: дёргает газету / отбивается (два кадра), над головой — мишень с таймером
func vulnerable_window(a, b):
    hitbox -150 150 140 330
    every frame:
        if a != "" and floor(time * 2.5) != floor((time - dt) * 2.5):
            if floor(time * 2.5) % 2 == 1: pose a
            else: pose b
        bomb_marker 1 - time / window_time()
        if time > window_time(): go approach

# Стая Пахана: один раз за бой налетает на бабку — она отмахивается, голова открыта
func call_flock():
    flock_used = true
    toast "Стая Пахана — на твоей стороне!"
    var colors = ["grey", "brown", "pale"]
    for i in range(6):
        var a = i * pi / 3
        var b = sprite("ambient", "", x - 900 + i * 60, y - 700 - i * 30, depth=21)
        anim b "ambient." + colors[i % 3] + "_fly"
        b.scale = 0.9
        tween b 0.7 x=(x + cos(a) * 140) y=(y - 420 + sin(a) * 70) ease="quad_out"
        tween b 0.8 x=(x + 1200) y=(y - 900) alpha=0 delay=3.2 kill=true
    go cover

# --- Состояния ---

state waiting:
    pose "granny_idle_01"
    alert false

state intro:
    face pigeon
    play "notice"
    say "Опять эти голуби?!" 1.5 450
    wait 1.6
    go approach

state approach:
    if ml_enabled: go policy
    play "walk"
    high_time = 0
    every frame:
        walk_toward(pigeon.x, WALK_SPEED * speed())
        if reachable(): high_time = 0
        else: high_time += dt
        # Вторая фаза: издалека — батоном
        if not street_mode and patience <= 2 and bag_cooldown <= 0 and abs(dx) > 380 and abs(dx) < 1100: go bagUp
        if abs(dx) < 300 and reachable(): go windup
        if high_time > HIGH_PATIENCE / speed() or time > 7: go shoutUp
        if abs(dx) > 650:
            if patience < max_patience() and random() < 0.5: go chargeUp
            go run

state policy:
    var motion = -1
    every frame:
        if not ml_enabled: go approach
        if ml_action == 1: walk_toward(pigeon.x, WALK_SPEED * speed())
        elif ml_action == 2:
            face pigeon
            x = clamp(x - facing * WALK_SPEED * speed() * dt, min_x, max_x)
        elif ml_action == 3: walk_toward(pigeon.x, RUN_SPEED * speed())
        var allowed = ml_mask()
        if ml_action == 4 and allowed[4]: go windup
        if ml_action == 5 and allowed[5]: go shoutUp
        if ml_action == 6 and allowed[6]: go chargeUp
        if ml_action == 7 and allowed[7]: go bagUp
        if motion != ml_action:
            motion = ml_action
            if motion == 3: play "run"
            elif motion in [1, 2]: play "walk"
            else: pose "granny_idle_01"

state run:
    play "run"
    every frame:
        walk_toward(pigeon.x, RUN_SPEED * speed())
        if floor(time * 6) != floor((time - dt) * 6): dust_at_feet(0.7)
        if abs(dx) < 300 and reachable(): go windup
        if time > 2.5 or not reachable(): go approach

state windup:
    face pigeon
    overhead = pigeon.feet_y < y - 230
    if overhead: pose "granny_windup_overhead"
    else: pose "granny_windup_01"
    alert true 470
    wait 0.75 / speed()
    go strike

state strike:
    strike_hit = false
    if overhead:
        play "smash"
        sfx "swing"
        sfx "smash"
    else:
        play "swing"
        sfx "swing"
    var swoosh = sprite("ui", "fx_swoosh", x + facing * 200, y - 200, depth=DEPTH_FX)
    if overhead: swoosh.y = y - 380
    swoosh.scale = 0.6
    swoosh.flip = facing < 0
    tween swoosh 0.3 alpha=0 kill=true
    every frame:
        if time < 0.18:
            if overhead: swat(-40, 320, 150, 620)
            else: swat(20, 360, 30, 340)
        if time >= 0.5: after_attack()

state shoutUp:
    face pigeon
    pose "granny_point"
    alert true 470
    say "А НУ КЫШ!!!" 1.1 450
    wait 0.75 / speed()
    go shout

state shout:
    play "shout"
    shout_wave()
    sfx "shout"
    wait 0.9
    after_attack()

state chargeUp:
    face pigeon
    pose "granny_ready"
    alert true 470
    say "Ну, держись!" 0.9 450
    every frame:
        if floor(time * 8) != floor((time - 1 / 60) * 8): dust_at_feet(0.6)
        if time > CHARGE_WINDUP: go charge

state charge:
    strike_hit = false
    play "chase"
    sfx "shout"
    every frame:
        x += facing * CHARGE_SPEED * dt
        x = clamp(x, min_x, max_x)
        swat(-60, 170, 0, 380)
        if floor(time * 10) != floor((time - dt) * 10): dust_at_feet(0.9)
        var at_wall = x <= min_x or x >= max_x
        if at_wall: shake 0.2 0.008
        if at_wall or time > 2.2: go tired

state tired:
    attacks = 0
    breath_timer = 0
    play "tired"
    sfx "sigh"
    if shown_tired_hint: say "Ох… дайте отдышаться…" 1.4 560
    else: say "Ох… сердце… надо присесть…" 1.4 560
    shown_tired_hint = true
    hitbox -150 150 140 330
    every frame:
        breath_timer -= dt
        if breath_timer <= 0:
            breath_timer = 0.6
            var puff = sprite("ui", "fx_dust_cloud", x + facing * 90, y - 250, depth=25)
            puff.scale = 0.18
            tween puff 0.5 x=(puff.x + facing * 50) alpha=0 scale=0.3 kill=true
        bomb_marker 1 - time / tired_time()
        if time > tired_time(): go approach

# Терпение уже снято в on hit; из авоськи вываливается булка — бабка сама кормит голубя
state hit:
    play "hit"
    sfx "ouch"
    shake 0.22 0.01
    feather x (y - 380) 3
    toss_food "bun" clamp(x + pick(-1, 1) * random_int(180, 320), min_x, max_x) from_x=x from_y=(y - 200)
    wait 0.9
    if patience <= 0: go defeated
    go angry

state angry:
    atlas = "l1_boss"
    pose "boss_steam"
    say pick("Ах ты ж паразит!", "Ну всё, держись!", "Я тебя газеткой!", "Совсем обнаглели!") 1 450
    wait 0.8
    if not street_mode and flock_ally and not flock_used and patience <= 2: call_flock()
    go approach

state victory:
    pose "granny_victory_01"
    say "Так тебе, паразит!" 1.6 450

state defeated:
    if street_mode: baton_clear
    pose "granny_stunned_01"
    depth = DEPTH_BEHIND
    sfx "sigh"
    say "Ох… всё… сдаюсь…" 2 330
    var dizzy = sprite("ui", "fx_dizzy", x, y - 300, depth=DEPTH_ALERT)
    dizzy.scale = 0.45
    tween dizzy 1.6 angle=360 repeat=-1
    broadcast "granny_defeated" x

# Подразнили: в ярости лупит газетой сверху — мощно, но предсказуемо; промахнулась — газета застревает
state rageUp:
    face pigeon
    pose "granny_windup_overhead"
    alert true 470
    say "Ах ты ещё и дразнишься?!" 1 470
    sfx "shout"
    wait 0.9
    go rage

state rage:
    strike_hit = false
    play "smash"
    sfx "smash"
    shake 0.22 0.01
    big_dust (x + facing * 200) y
    every frame:
        # Газетой сверху вниз перед собой — широко и высоко
        if time < 0.2: swat(-30, 380, 0, 640)
        if time >= 0.45:
            if strike_hit: go approach
            go stuck

# Тянет газету, застрявшую в земле
state stuck:
    atlas = "l1_boss"
    pose "boss_stuck_01"
    attacks = 0
    say "Газета… застряла!" 1.4 450
    vulnerable_window("boss_stuck_02", "boss_stuck_01")

state bagUp:
    face pigeon
    atlas = "l1_boss"
    pose "boss_windup"
    alert true 470
    say "Получай батоном!" 0.9 470
    wait 0.85 / speed()
    go bagThrow

state bagThrow:
    atlas = "l1_boss"
    pose "boss_throw"
    sfx "whoosh"
    bag = sprite("l1_boss", "boss_baguette", x + facing * 140, y - 300, depth=21)
    # По дуге туда, где голубь сейчас: летит сам, ложится чуть выше тротуара
    var v = ballistic(bag.x, bag.y, pigeon.x, pigeon.feet_y - 60, 0.85, BAG_GRAVITY)
    fly bag v[0] v[1] BAG_GRAVITY spin=540 ground=(ground - 10)
    bag_cooldown = 5
    wait 0.5
    after_attack()

state wet:
    atlas = "l1_boss"
    pose "boss_wet"
    attacks = 0
    say "Зинаида!!! Ты что творишь?!" 1.6 450
    sfx "splat"
    if not basin_done:
        basin_done = true
        award 400 "Бабку облили!" x (y - 500)
        deed "granny_basin"
    vulnerable_window("", "")

state cover:
    atlas = "l1_boss"
    pose "boss_cover"
    attacks = 0
    say "Кыш! Кыш, проклятые!" 1.4 450
    vulnerable_window("boss_swat", "boss_cover")

on leave(s):
    atlas = "granny"
    if s in [windup, shoutUp, chargeUp, rageUp, bagUp]: alert false
    if s in [tired, stuck, wet, cover]:
        overlay_off
        hitbox -100 100 160 420

# --- События ---

# Клюнуть в момент замаха батоном: батон падает и становится едой
on peck:
    if street_mode:
        if state != tired: return false
        patience = max(0, patience - 1)
        score_hit 100
        go hit
        return true
    if state != bagUp: return false
    spawn_food "baguette" (x + facing * 140) ground
    award 150 "Батон выбит!" x (y - 470)
    say "Мой батон!!!" 1 450
    go angry
    return true

on taunt:
    if state in [approach, run, policy] and abs(dx) < 520:
        go rageUp
        return true
    return false

on kick:
    if not street_mode or state != tired: return false
    patience = max(0, patience - 1)
    go hit
    return true

on weapon_hit(weapon):
    if not street_mode or weapon != "baton" or not (state in [knock_fall, knock_down]): return false
    patience = max(0, patience - 2.5)
    hurt_flash = 0.3
    score_hit 200
    if patience <= 0: go defeated
    return true

on hit:
    if state in [waiting, hit, angry, defeated, victory]: return
    if street_mode:
        if state in [knock_fall, knock_down, knock_rise]: return
        if graze_cooldown > 0: return
        graze_cooldown = GRAZE_COOLDOWN
        patience = max(0, patience - 0.5)
        score_hit 50
        if patience <= 0: go defeated
        if knock_guard > 0: return
        baton_drop clamp(x + facing * 160, min_x, max_x) y
        go knock_fall
        return
    if vulnerable():
        # В окне — целое сердечко
        patience = max(0, patience - 1)
        score_hit 100
        hit_stop 0.11
        popup x (y - 470) "−1 терпение" "#ff6b5b"
        go hit
        return
    # Вне окна — полсердечка, без остановки атаки
    if graze_cooldown > 0: return
    graze_cooldown = GRAZE_COOLDOWN
    patience = max(0, patience - GRAZE_DAMAGE)
    score_hit 30
    impact hx hy
    popup x (y - 470) "−½ терпения" "#ffb347"
    shake 0.1 0.004
    if patience <= 0:
        go hit
        return
    if say_cooldown <= 0:
        say pick("Ах ты ж!", "Тьфу на тебя!", "Ну погоди у меня!") 0.9 440
        say_cooldown = 2

state knock_fall:
    alert false
    overlay_off
    atlas = "l1_granny_down"
    play "fall"
    hitbox -170 230 0 260
    wait 0.42
    go knock_down

state knock_down:
    atlas = "l1_granny_down"
    hitbox -170 230 0 260
    play "down"
    was_hurt = false
    every frame:
        if hurt_flash > 0:
            pose "hurt"
            was_hurt = true
        elif was_hurt:
            play "down"
            was_hurt = false
        if baton_window() <= 0: go knock_rise

state knock_rise:
    baton_clear
    atlas = "l1_granny_down"
    play "rise"
    wait 0.5
    knock_guard = 2
    hitbox -100 100 160 420
    go approach

# --- Каждый кадр: батон в полёте, таз соседки ---

func update_bag():
    if bag == nil: return
    if pigeon_in(bag.x - 60, bag.y - 30, 120, 60):
        hurt_pigeon bag.x
        kill bag
        bag = nil
        return
    if bag.landed:
        # Мимо — батон остаётся на земле: еда
        spawn_food "baguette" bag.x ground
        kill bag
        bag = nil

# Третья фаза: соседка показывается в окне (телеграф) и выливает таз под окно. Под водой голубь получает
# урон, а бабка — промокает и надолго открыта
func update_basin():
    if window_x == 0 or state in [waiting, defeated, victory] or patience > 1: return
    basin_t += dt
    if basin_phase == 0:
        basin_in -= dt
        if basin_in <= 0:
            basin_phase = 1
            basin_t = 0
            neighbour = sprite("l1_boss", "neighbour_look", window_x, SILL + 20, depth=DEPTH_GROUND, origin_x=0.5, origin_y=1)
            neighbour.alpha = 0
            tween neighbour 0.3 alpha=1
            say_at window_x (SILL - 260) pick("Опять шумите?!", "Ну я вам сейчас!") 1.2
    elif basin_phase == 1:
        if basin_t > 0.6: neighbour.frame = "l1_boss.neighbour_basin"
        if basin_t > 1.4:
            basin_phase = 2
            basin_t = 0
            neighbour.frame = "l1_boss.neighbour_pour"
            pour = sprite("l1_misc", "fx_pour", window_x + POUR_DX, ground, depth=DEPTH_PROJECTILE, origin_x=0.5, origin_y=1)
            pour.scale_y = (ground - SILL) / 246
    elif basin_phase == 2:
        if basin_t < 0.6 and pigeon_in(window_x + POUR_DX - POUR_W / 2, SILL, POUR_W, ground - SILL):
            hurt_pigeon window_x
        if basin_t < 0.6 and abs(x - window_x - POUR_DX) < 150 and not vulnerable() and state != hit: go wet
        if basin_t > 0.7:
            basin_phase = 3
            basin_t = 0
            kill pour
            pour = nil
            splat (window_x + POUR_DX) ground
            neighbour.frame = "l1_boss.neighbour_laugh"
    elif basin_phase == 3:
        if basin_t > 1.2:
            tween neighbour 0.3 alpha=0 kill=true
            neighbour = nil
            basin_phase = 0
            basin_in = random(6, 8)

every frame:
    # Полоса терпения под очками — пока идёт бой
    if state in [waiting, defeated] or not in_arena("boss"): hide_boss_bar
    else: boss_bar "Бабка с газетой" patience max_patience()
    knock_guard = max(0, knock_guard - dt)
    hurt_flash = max(0, hurt_flash - dt)
    say_cooldown -= dt
    graze_cooldown -= dt
    bag_cooldown -= dt
    update_bag()
    update_basin()
