character control_lever:
    title "Пульт заслонки"
    preview "l1_control_lever.off"
    atlas = "l1_control_lever"
    hitbox -90 90 0 205
    immune = true
    shadow = 0
    depth = -8.9

func unlock():
    run_flag "road_box_open" true
    go activated
    toast "Заслонка щитка открыта"

state off:
    pose "off"
    if run_flag("road_box_open"): go activated

state activated:
    pose "on"

on location_enter(id):
    if run_flag("road_box_open"): go activated

on location_loaded(id):
    if run_flag("road_box_open"): go activated

every frame:
    if not run_flag("road_box_open") and abs(dx) < 350:
        hint_once "service_lever" "Рычаг открывает заслонку щитка. Заберись на ящик и пни ({kick})"

on peck:
    if not run_flag("road_box_open"):
        popup x (y - 240) "Рычаг нужно пнуть" "#ffe066"
    return true

on kick:
    if run_flag("road_box_open") or cutscene_playing(): return true
    if pigeon.feet_y > y - 20:
        popup x (y - 240) "С ящика будет удобнее" "#ffe066"
        return true
    play_cutscene "hut_service"
    return true
