# Лампа — единственный источник света в комнате. Фон остаётся одним и тем же.
character hut_lamp:
    title "Подвесная лампочка"
    preview "l1_hut_light.bulb"
    atlas = "l1_hut_light"
    hitbox -28 28 0 60
    immune = true
    shadow = 0
    depth = DEPTH_BACK
    room = room_light(0, 0, 1920, 1080, x, y - 24, 1900, "#ffe0ac", 0, "#0c0e12")
    halo = glow(x, y - 24, 62, "#ffc46e", 0.3, depth=19)
    filament = glow(x, y - 24, 20, "#fff1c9", 0.85, depth=19)
    halo.visible = false
    filament.visible = false

var room = nil
var halo = nil
var filament = nil

func sync_light():
    if run_flag("hut_bulb_broken"): go broken
    elif run_flag("hut_light_on"): go lit
    else: go dark

state dark:
    pose "bulb"
    room.intensity = 0
    halo.visible = false
    filament.visible = false
    if run_flag("hut_bulb_broken"): go broken
    elif run_flag("hut_light_on"): go lit

state lit:
    pose "bulb"
    room.intensity = 1.55
    halo.visible = true
    filament.visible = true

state broken:
    pose "broken"
    room.intensity = 0
    halo.visible = false
    filament.visible = false

on location_enter(id):
    sync_light()

on location_loaded(id):
    sync_light()

on hut_light_changed:
    sync_light()

on kick(dir, wing):
    if state == broken or not wing: return false
    run_flag "hut_bulb_broken" true
    run_flag "hut_light_on" false
    go broken
    broadcast "hut_light_changed"
    sfx "shatter"
    sparks x (y - 24) 7
    shock_pigeon x
    for i in range(8):
        var chip = sprite("l1_hut_light", "chip", x + random(-18, 18), y - 24, depth=DEPTH_FRONT)
        chip.scale = random(0.65, 1.25)
        fly chip (dir * 90 + random(-160, 160)) random(-160, 40) 900 random(-420, 420) 943
        tween chip 0.4 alpha=0 delay=1.1 kill=true
    return true
