# Пролог уровня 1: студент на лавке учит «клюнуть». Жуёт бутерброд — вырви из рук; без бутерброда сидит
# в телефоне — клюнь в ногу, подпрыгнет и выронит; телефон разбит — рыдает.

character student:
    title "Студент"
    preview "l1_people.student_eat"
    look_at pigeon
    atlas = "l1_people"
    depth = DEPTH_BEHIND
    hitbox -120 120 0 360
    # Сквозь него не пройти; клевать бутерброд и ногу — с края (клюв дотягивается)
    solid = true
    body -90 90 0 300
    if level.facing == 0: facing = -1

state eat:
    play "student_eat"

state shock:
    pose "student_shock"
    say pick("Эй! Мой бутерброд!", "Это же был обед!") 1.4 400
    wait 1.4
    go phone

state phone:
    pose "student_phone"

# Подпрыгнул на месте — и опустился; телефон летит на тротуар
state hop:
    pose "student_hop"
    if in_view(): sfx "ouch"
    var phone = sprite("l1_misc", "item_phone_cracked", x + facing * 40, y - 200, depth=DEPTH_NPC, origin_x=0.5, origin_y=1)
    phone.angle = -30
    tween phone 0.45 x=(x + facing * 170) y=(ground + 6) angle=8 ease="quad_out"
    # Дальше телефон — в кадре плача (лежит разбитый у колен)
    tween phone 0.2 alpha=0 delay=0.55 kill=true
    award 150 "Телефон вдребезги!" x (y - 420)
    deed "student_phone"
    every frame:
        draw_dy = -sin(min(1, time / 0.5) * pi) * 40
        if time > 0.8:
            draw_dy = 0
            go cry

state cry:
    play "student_cry"
    say pick("Мой телефо-о-он!", "Там же курсовая!!!") 2 360

state angry:
    face pigeon
    pose "student_angry"
    say pick("Отстань, птица!", "Тебе мало?!") 1.2 440
    if abs(dx) < 200: shove_pigeon
    wait 1.4
    go cry

# Клюнул: бутерброд — из рук; телефон — в ногу; плачущего — разозлить
on peck:
    if state == eat:
        spawn_food "sandwich" (pigeon.x + pigeon.facing * 50) ground
        award 80 "Вырвал из рук!" x (y - 380)
        sfx "shove"
        go shock
        return true
    if state == phone:
        go hop
        return true
    if state == cry:
        go angry
        return true
    return false

on hit:
    score_hit 60
    if state == eat:
        # С перепугу роняет бутерброд к ногам
        spawn_food "sandwich" (x + facing * 80) ground
        go shock
    else:
        say pick("Фу-у-у!", "Да за что?!") 1.2 400
