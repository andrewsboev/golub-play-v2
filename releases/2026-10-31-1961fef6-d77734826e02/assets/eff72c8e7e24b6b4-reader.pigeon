# Пролог уровня 1 (docs/LEVEL1_PLAN.md §6): бабушка на лавке читает газету «Мэрия: голуби — враг города №1».
# На голубя не обращает внимания — сидит и читает; голубь рядом — плашка «Война так война» (один раз).

character reader:
    title "Бабушка с газетой"
    preview "l1_people.reader_read_01"
    atlas = "l1_people"
    depth = DEPTH_BEHIND
    # Точка привязки — у ног, справа от фигуры: сама бабушка от −190 до +85
    hitbox -190 85 0 330
    # Голубь сквозь неё не проходит
    solid = true
    # Сидит: поворачивается на лавке, а не пересаживается
    turn_in_place = true
    # По фигуре и чуть выше макушки: верх забора и спинка лавки за ней — на уровне головы, сесть там значит сесть
    # ей на голову — выталкивает вбок
    body -190 85 0 360
    say_height = 360

# Голубь ближе этого — плашка правил
const NOTICE = 420

var shown = false

state read:
    play "reader_read"
    wait until not shown and abs(dx) < NOTICE
    shown = true
    banner "Война так война" "Мэрия объявила голубям войну. Устрой району утро, о котором напишут газеты"

state upset:
    pose "reader_point"
    say pick("Хулиган пернатый!", "Вот про таких и пишут!") 1.6
    wait 1.8
    go read

on hit:
    if state == upset: return
    penalty 50
    go upset
