# Участник свадебной процессии (procession.pigeon создаёт их сам): waiter, groom, bride, aunt. Место в строю —
# slot (от тележки); строем и рисом командует «режиссёр» (parent).

import common

character wed_member:
    preview "wedding.aunt_walk_01"
    atlas = "wedding"
    role = level.role
    wed = parent
    alpha = 0
    if role == "aunt": hitbox -80 80 0 360
    else: hitbox -70 70 0 400
    # Свадьбу насквозь не пролететь: в полёте голубь бьётся о гостей и отлетает — разогнать или облететь поверху
    solid = true
    say_height = 440
    death_line = "Голубь сбит свадебным букетом. Гости аплодируют"

const GROOM_SPEED = 330

var role = ""
var wed = nil
var slot = 0
var hit_cooldown = 0
var bob = random(10)

func face_to_pigeon():
    face pigeon

# Ступенька у двери: официант спотыкается сам — подсказка
func stumble():
    pose "waiter_hop"
    say "Ой-ой-ой! Ступенька!" 1.4 430

state walk:
    facing = wed.dir
    if role == "waiter": play "waiter_walk"
    elif role == "groom": pose "groom_run_01"
    elif role == "bride": play "bride_run"
    else: play "aunt_walk"

state throw:
    play "aunt_throw"
    wait 0.9
    go walk

state windup:
    face pigeon
    pose "bride_windup"
    say pick("Лови, пернатый!", "Кто поймает — следующий!") 0.8
    wait 0.7
    wed.throw_bouquet()
    go threw

# Держит позу броска, потом снова в строй
state threw:
    pose "bride_throw"
    wait 0.5
    go walk

state chase:
    play "groom_run"
    every frame:
        face pigeon
        x += facing * GROOM_SPEED * dt
        if abs(dx) < 170: go swing
        if time > 3 or not pigeon.on_ground: go walk

state swing:
    face pigeon
    pose "groom_swing_02"
    sfx "swing"
    wait 0.18
    pose "groom_swing_01"
    if abs(dx) < 240:
        shove_pigeon
        say pick("Пошёл вон!", "Не сегодня!") 0.9 450
    wait 0.42
    go walk

# Жених отпихивает голубя ногой и догоняет строй
state kick:
    face pigeon
    play "reactions.groom_kick"
    wait 0.15
    sfx "swing"
    shove_pigeon from_x=x
    say pick("Пошёл вон!", "Не сегодня!") 0.9 450
    wait 0.45
    go walk

state hit:
    if role == "aunt":
        pose "aunt_hit"
        say pick("Моя шляпа!!!", "Это от Диора!") 1 420
    elif role == "bride":
        pose "bride_cry"
        say "Платье!!!" 1
    else:
        pose "waiter_scream"
    if in_view(): sfx "ouch"
    wait 0.9
    go walk

state hop:
    pose "waiter_hop"
    say "Ай! Тележка!!!" 1 430
    if in_view(): sfx "ouch"
    wait 0.6
    go run

state run:
    play "waiter_run"

state panic:
    if role == "waiter": pose "waiter_scream"
    elif role == "bride": pose "bride_cry"
    elif role == "groom": pose "groom_slip"
    else: pose "aunt_clutch"

state caked:
    pose "groom_cake"
    say "Это… был… наш торт…" 2 470

state flee:
    play "aunt_flee"
    run_away(1, 300, 1.5)

on hit:
    if hit_cooldown > 0: return
    hit_cooldown = 1.5
    score_hit 60
    if not wed.active(): return
    if role in ["aunt", "bride", "waiter"] and state in [walk, throw]: go hit
    if role == "groom": say pick("Мой костюм!", "Это прокатный смокинг!") 1.1

# Жених отпихивает голубя, подошедшего пешком (официанта клюют в ногу — он не пинает); в полёте — голубь бьётся
# о гостей и отлетает
on bump(flying, speed):
    if flying or role != "groom" or not wed.active(): return false
    if state == kick: return true
    if state != walk: return false
    go kick
    return true

# Клюнуть официанта в ногу — подпрыгнет, тележка покатится сама (позорная победа). Остальные — кыш
on peck:
    if not wed.active(): return false
    if role == "waiter" and wed.state == "march":
        go hop
        wed.waiter_tripped()
        return true
    say pick("Кыш! Это свадьба!", "Пошёл вон, птица!") 0.9 430
    if abs(dx) < 240: shove_pigeon
    return true

every frame:
    hit_cooldown = max(0, hit_cooldown - dt)
    immune = wed.state == "waiting" or state == flee
    var moving = state in [walk, chase, flee, run]
    if moving:
        bob += dt * 8
        draw_dy = -abs(sin(bob)) * 4
    else:
        bob += dt * 2
        draw_dy = sin(bob) * 1.2
