# Общий код персонажей: import common (docs/PIGEONSCRIPT.md, «Библиотеки»).

# Убежать и растаять: dir 1 или -1 — куда, 0 — прочь от голубя; идёт со скоростью speed px/с, через fade_after
# секунд от начала состояния тает (0.6 с) и исчезает. Звать из состояния: ждёт, пока персонаж не исчезнет.
func run_away(dir, speed, fade_after):
    if dir != 0: facing = dir
    elif pigeon.x > x: facing = -1
    else: facing = 1
    every frame:
        x += facing * speed * dt
        if time > fade_after: alpha = max(0, 1 - (time - fade_after) / 0.6)
        if time > fade_after + 0.6:
            vanish
            return
