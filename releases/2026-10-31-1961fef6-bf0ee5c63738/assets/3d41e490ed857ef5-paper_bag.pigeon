# Смятый бумажный пакет из-под фастфуда на тротуаре (уровень 1): клюнуть или пнуть — рвётся, внутри крошки.

import props

character paper_bag:
    title "Бумажный пакет"
    preview "l1_home.paperbag"
    preview "items.nest_newspaper"
    show("l1_home", "paperbag", "items", "nest_newspaper")
    hitbox -50 50 0 60
    shadow = 0

var torn = false

func tear():
    torn = true
    if has_frame("l1_home.paperbag_torn"): pose "l1_home.paperbag_torn"
    else: scale_y = 0.6
    sfx "rip_paper"
    var side = -away()
    toss_food "crumbs_pile" (x + side * 90) x (ground - 60)
    toss_food "crumbs" (x - side * 70) x (ground - 60)

state lie:
    pass

on peck:
    if torn: return false
    tear()
    return true

on kick:
    if not torn: tear()
    else: wobble()
    return true
